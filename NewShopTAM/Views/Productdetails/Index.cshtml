                        $("#textAlertWarninglog").empty();
                        $("#textAlertWarninglog").text("Order quantity cannot be less than " + Spackuom + " (Sales Packing Standard )");
                        $("#myModalWarninglog").modal();// return false;
                        $(this).val(""); //return false;
                        $("#bckorder" + res).val("");
