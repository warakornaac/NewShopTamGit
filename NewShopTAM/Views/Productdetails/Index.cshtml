        $(document).on('focusout', '[id^="expectprice"]', function () {
            var $input = $(this);
            var text = $input.val();
            var divSpc = $('#spc-hide');
            if (text != '') {
                var rowIdPart = $input.attr('id').replace('expectprice', 'spcRemake');
                var $select = $('#' + rowIdPart);
                divSpc.removeAttr('hidden');
                var currentRemark = $select.closest('div').find('.spc_remarkxxx').text().trim();
                console.log(`text spc : ${currentRemark}`);
                $.ajax({
                    url: '@Url.Action("GetSpcRemark", "Shoppinglist")',
                    data: {},
                    type: 'post',
                    dataType: 'Json',
                    beforeSend: function () {
                    },
                    success: function (data) {
                        if (data.respone == 'Y') {
                            $select.empty();
                            $select.append('<option value="">-- Select Remark --</option>');
                            data.result.forEach(item => {
                                const selected = (item.VAL.trim() === currentRemark) ? 'selected' : '';
                                $select.append(`<option value="${item.VAL}" ${selected}>${item.VAL}</option>`);
                                console.log(`select spc : ${selected}`);
                            });//for end
                        }//sub if
                        else {
                            console.warn(data.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('AJAX Error:', error);
                    }
                });//end ajax
            }// end if
            else {
                var rowIdPart = $input.attr('id').replace('expectprice', 'spcRemake');
                var $select = $('#' + rowIdPart);
                divSpc.attr('hidden', true);
            }
        });
