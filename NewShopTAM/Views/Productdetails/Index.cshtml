                    var vck = parseFloat(valqty) - parseFloat(valstock)
                    $("#bckorder" + res).val(vck);
                } else if (parseFloat(valqty) < parseFloat(valstock)) {
                    var vck = parseFloat(valstock) - parseFloat(valqty)
