    }
    //save PackQty
    function savePackPromotionBySeq(txtReason) {
        console.log("txtReason = " + txtReason);
        var packQtyLast = $("#packQty").val().replace(/\,/g, '');
        //return false;
        $.ajax({
            type: 'POST',
            cache: false,
            url: '@Url.Action("SaveCustomerRegister", "Promotion")',
            data: {
                user: '@Session["UserID"]',
                slmCode: $("#slmCode").val(),
                cusCode: $("#customerCode").val(),
                promotionCode: $("#promotionCode").val(),
                promotionSeq: $("#promotionSeq").val(),
                packQty: $("#packQty").val(),
                packAmt: $("#packAmt").val().replace(/\,/g, ''),
                sumPackAmt: $("#sumPackAmt").val().replace(/\,/g, ''),
                txtReason: txtReason
            },
            beforeSend: function () {
                LoadingShow();
            },
            success: function (result) {
                if (result.status == "Y") {
                    if (packQtyLast > 0) {
                        console.log("packQtyLast = " + packQtyLast);
                        $("#packQtyOld").val(packQtyLast);
                    }
                    getListPackPromotionByCustomer();
                    Swal.fire({
                        title: 'บันทึกเรียบร้อย',
                        icon: 'success',
                        confirmButtonColor: '#3085d6',
                        confirmButtonText: 'ปิด',
                        allowOutsideClick: false,
                        focusConfirm: false,
                        timer: 5000,
                        timerProgressBar: true,
                        onClose: () => {
                            LoadingHide();
                        }
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error not saved',
                        html: result.status,
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'ปิด',
                        allowOutsideClick: false,
                        focusConfirm: false,
                    });
                }
            },
            complete: function () {
                LoadingHide();
            }
        }).fail(function () {
            Swal.fire({
                icon: 'error',
                title: 'Error not saved',
                html: 'กรุณาแจ้งผู้ดูแลระบบ<br>โดยการแคปหน้าจอและก๊อปปี้ Error ด่านล่างนี้<br>btnSavePackPromotionBySeq<br><br>',
                confirmButtonColor: '#d33',
                confirmButtonText: 'ปิด',
                allowOutsideClick: false,
                focusConfirm: false,
            });
        });
    }
    //get table list pack by customer
    function getListPackPromotionByCustomer() {
        var customerCode = $("#customerCode").val();
        var promotionCode = $("#promotionCode").val();
        var promotionSeq = $("#promotionSeq").val();

       $.ajax({
            type: 'post',
            url: '@Url.Action("GetListPackPromotionByCustomerCurrent", "Promotion")',
            data: {
                slmCode: '',
                customerCode: customerCode,
                promotionCode: promotionCode,
                promotionSeq: promotionSeq,
            },
            dataType: 'html',
            cache: false,
            Async: true,
            beforeSend: function () {
                $('#listPackPromotionByCustomer').empty();
                $('#listPackPromotionByCustomer').html('<div style="padding: 30px; font-size: 14px;"> <i class="fa fa-spinner fa-spin fa-2x" aria-hidden="true"></i> กำลังโหลดข้อมูล... </div>');
                // LoadingShow();
            },
            success: function (res) {
                // LoadingHide();
                $('#listPackPromotionByCustomer').html(res);
            },
            error: function (er) {
                alert(er.error);
            }
        }).fail(function (error) {
            Swal.fire({
                icon: 'error',
                title: error.status,
                html: 'กรุณาแจ้งผู้ดูแลระบบ<br>โดยการแคปหน้าจอและก๊อปปี้ Error ด่านล่างนี้<br>_ListPackPromotionByCustomer<br><br>',
                confirmButtonColor: '#d33',
                confirmButtonText: 'ปิด',
                allowOutsideClick: false,
                focusConfirm: false,
            });
        });
    }
    //คำนวณยอดเงินรวม
    function calSumPackAmt(packQty) {
        var packAmt = $("#packAmt").val().replace(/\,/g, '');;
        var sumPackAmt = 0;
        if (packQty > 0) {
            sumPackAmt = packAmt;
        }
        if (packQty > 0 && packAmt > 0) {
            sumPackAmt = packQty * packAmt;
        }
        $('#sumPackAmt').val(numberWithCommas(sumPackAmt));
    }

    document.querySelectorAll('.number-spinner .btn').forEach(button => {
        button.addEventListener('click', function () {
            const input = document.getElementById('adult');
            let oldValue = parseInt(input.value, 10);
            const min = parseInt(input.getAttribute('min'), 10);
            const max = parseInt(input.getAttribute('max'), 10);
            const direction = this.getAttribute('data-dir');

            if (direction === 'up' && oldValue < max) {
                input.value = oldValue + 1;
            } else if (direction === 'dwn' && oldValue > min) {
                input.value = oldValue - 1;
            }
        });
    });
</script>
