    <div class="col-sm-12 col-md-6 col-lg-3">
        <div class="form-group highlight-addon">
            <label class="control-label has-star">
                จำนวนแพ็ค
                @if (ViewBag.flagApprove == "Y")
                {
                    <span class="label label-danger mt-1">
                        รอ Approve
                        @if (!string.IsNullOrEmpty(ViewBag.packQtyPedingApprove))
                        {
                            @("(" + ViewBag.packQtyPedingApprove + ")")
                        }
                    </span>
                }
            </label>
            <div class="input-group" style="width: 90%;">
                <span class="input-group-btn">
                    <button type="button" @flagSavePack class="btn btn-danger btn-number" data-type="minus" data-field="packQty" style="padding: 0 18px;">
                        <i class="fa fa-minus" style="margin-left: -4px;"></i>
                    </button>
                </span>
                <input type="text" name="packQty" @flagPendding id="packQty" class="form-control input-number text-center" value="@ViewBag.packQty" max="100" min="0" onkeyup="calSumPackAmt(this.value);" style="margin: 0 10px 0 35px;">
                <span class="input-group-btn">
                    <button type="button" @flagSavePack class="btn btn-success btn-number" data-type="plus" data-field="packQty" style="padding: 0 18px; margin-left: -11px;">
                        <i class="fa fa-plus" style="margin-left: -4px;"></i>
                    </button>
                </span>
            </div>
            <input type="hidden" name="packQtyOld" id="packQtyOld" value="@ViewBag.packQty">
        </div>
    </div>
    <div class="col-sm-12 col-md-6 col-lg-3">
        <div class="form-group highlight-addon">
            <label class="control-label has-star">รวมเป็นเงิน</label>
            <div class="input-group">
                <span class="input-group-addon" style="padding-right: 20px;"><i class="fa fa-dollar"></i></span>
                <input type="text" name="sumPackAmt" id="sumPackAmt" class="form-control text-right" disabled value="@ViewBag.sumPackAmt.ToString("N0")" maxlength="10" onkeypress="return validateFloatKeyPress(this,event);">
            </div>
        </div>
    </div>
    <div class="col-sm-2 col-md-6 col-lg-3">
        <label class="control-label has-star"> &nbsp; </label>
        <div class="form-group">
            <button @flagSavePack type="button" class="btn btn-success" id="btnSavePackPromotion" onClick="btnSavePackPromotionBySeq();"><i class="fa fa-save"></i> บันทึก </button>
        </div>
    </div>
</div>

<div id="listPackPromotionByCustomer">
    @Html.Partial("_ListPackPromotionByCustomer", (List<listCustomerRegister>)ViewBag.customerRegisterList)
</div>

<script defer>
    //input number
    $("#packQty").on("click", function () {
        $(this).select();
    });

    $('.btn-number').click(function (e) {
        e.preventDefault();
        fieldName = $(this).attr('data-field');
        type = $(this).attr('data-type');
        var input = $("input[name='" + fieldName + "']");
        var currentVal = parseInt(input.val());
        if (!isNaN(currentVal)) {
            if (type == 'minus') {
                if (currentVal > input.attr('min')) {
                    input.val(currentVal - 1).change();
                }
                if (parseInt(input.val()) == input.attr('min')) {
                    $(this).attr('disabled', true);
                }
            } else if (type == 'plus') {

                if (currentVal < input.attr('max')) {
                    input.val(currentVal + 1).change();
                }
                if (parseInt(input.val()) == input.attr('max')) {
                    $(this).attr('disabled', true);
                }
            }
        } else {
            input.val(0);
        }
    });
    $('.input-number').focusin(function () {
        $(this).data('oldValue', $(this).val());
    });
    $('.input-number').change(function () {

        minValue = parseInt($(this).attr('min'));
        maxValue = parseInt($(this).attr('max'));
        valueCurrent = parseInt($(this).val());

        name = $(this).attr('name');
        if (valueCurrent >= minValue) {
            $(".btn-number[data-type='minus'][data-field='" + name + "']").removeAttr('disabled')
        } else {
            alert('Sorry, the minimum value was reached');
            $(this).val($(this).data('oldValue'));
        }
        if (valueCurrent <= maxValue) {
            $(".btn-number[data-type='plus'][data-field='" + name + "']").removeAttr('disabled')
        } else {
            alert('Sorry, the maximum value was reached');
            $(this).val($(this).data('oldValue'));
        }
        //console.log('Click = ' + valueCurrent);
        calSumPackAmt(valueCurrent);

    });
    $(".input-number").keydown(function (e) {
        // Allow: backspace, delete, tab, escape, enter and .
        if ($.inArray(e.keyCode, [46, 8, 9, 27, 13, 190]) !== -1 ||
            // Allow: Ctrl+A
            (e.keyCode == 65 && e.ctrlKey === true) ||
            // Allow: home, end, left, right
            (e.keyCode >= 35 && e.keyCode <= 39)) {
            // let it happen, don't do anything
            return;
        }
        // Ensure that it is a number and stop the keypress
        if ((e.shiftKey || (e.keyCode < 48 || e.keyCode > 57)) && (e.keyCode < 96 || e.keyCode > 105)) {
            e.preventDefault();
        }
    });
    //end input number
    function numberWithCommas(x) {
        var parts = x.toString().split(".");
        parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        return parts.join(".");
    }
    function validateFloatKeyPress(el, evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode;
        var number = el.value.split('.');
        if (charCode != 46 && charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }
        //just one dot
        if (number.length > 1 && charCode == 46) {
            return false;
        }
        //get the carat position
        var caratPos = getSelectionStart(el);
        var dotPos = el.value.indexOf(".");
        if (caratPos > dotPos && dotPos > -1 && (number[1].length > 1)) {
            return false;
        }
        return true;
    }
    function getSelectionStart(o) {
        if (o.createTextRange) {
            var r = document.selection.createRange().duplicate()
            r.moveEnd('character', o.value.length)
            if (r.text == '') return o.value.length
            return o.value.lastIndexOf(r.text)
        } else return o.selectionStart
    }
    //ดึงยอดรวมก่อน และหลังที่จะเพิ่ม
    function GetAmountPromotionByCustomer(customerCode, promotionCode, promotionSeq, packQty, packAmt, sumPackAmt) {
        var form = '';
        $.ajax({
            type: 'POST',
            cache: false,
            url: '@Url.Action("GetAmountPromotionByCustomer", "Promotion")',
            data: {
                customerCode: customerCode,
                promotionCode: promotionCode,
                promotionSeq: promotionSeq,
                packQty: packQty,
                packAmt: packAmt,
                sumPackAmt: sumPackAmt,
            },
            success: function (result) {
                form += '<form id="form-add-pack" style="text-align: center;">';
                form += '<label> จากทั้งหมด ' + result.sumPackQtyCurrent + ' แพ็ค (รวมเป็นเงิน ' + result.sumPackAmtCurrent + ')</label> <br>'
                form += '<label> คงเหลือ ' + result.sumPackQtyAfter + ' แพ็ค (รวมเป็นเงิน ' + result.sumPackAmtAfter + ')</label> <br>'
                form += '</form>';
            },
            complete: function (res) {
                LoadingHide();
            }
        })
        return form;
    }

