                    }
                });
            } else {
                var formReason = '<form id="form-remark" style="text-align: left;">';
                formReason += '<label>เหตุผล</label><textarea id="txtReason" name="txtReason" rows="4" style="width:100%; background: none;" class="form-control"> </textarea>'
                formReason += '</form>';
