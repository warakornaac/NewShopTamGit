    $("input[name='selectPromotion']").click(function () {
        var countCustomerReg = 0;
        $("input[name='selectPromotion']:checked").each(function () {
            var cuscode = $(this).data("cuscode");
            if (cuscode != null) {
                countCustomerReg++;
            }
        });
        $("#countCustomerReg").text(countCustomerReg);
    });
    //btn save
    saveCustomerRegister = async () => {
        var request = [];
        var slmCode = $("#slmCode option:selected").val();
        var promotionCode = $("input[name=selectPromotionSub]:checked").data('code');
        var promotionSeq = $("input[name=selectPromotionSub]:checked").data('seq');
