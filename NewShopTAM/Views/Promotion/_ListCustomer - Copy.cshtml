                //    success: function (res) {
                //        LoadingHide();
                //        if (res['status'] == 'Y') {
                //            Swal.fire({
                //                icon: 'success',
                //                title: res['msg'],
                //                showConfirmButton: false,
                //                timer: 1500
                //            }).then((result) => {
                //                LoadingShow();
                //                location.reload();
                //            });
                //        } else {
                //            Swal.fire({
                //                icon: 'error',
                //                title: 'กรุณาตรวจสอบและลองใหม่อีกครั้ง',
                //                html: res['msg'],
                //            });
                //            return false;
                //        }
                //    }
                //});
            } else if (result.dismiss == 'cancel') {
                console.log('cancel');
                $("#list-code-" + cuscode).prop('checked', false);
                $('.select_promotion_' + cuscode + '_' + promotioncode + '_' + promotionseq).attr('data-valuepack', 0);
                $('.select_promotion_' + cuscode + '_' + promotioncode + '_' + promotionseq).attr('data-valuepacksumamt', 0);
            }
        });
    }

    //ClickCheckbox
    $('input[name="selectPromotion"]').on('change', function () {
        var cuscode = $(this).data("cuscode");
        var cusname = $(this).data("cusname");
        var pack = $(this).data("pack") || 1;
        var packamt = $(this).data("packamt") || 0;
        var sumpack = $(this).data("sumpack") || 0;
        var promotioncode = $(this).data("promotioncode") || "";
        var promotionseq = $(this).data("promotionseq") || "";

        if ($(this).is(':checked')) { //เลือกร้าน checked
            popupAddPack(cuscode, cusname, pack, packamt, sumpack, promotioncode, promotionseq)
        } else {//กรณีกดยกเลิก Check
            Swal.fire({
                title: 'ต้องการยกเลิก',
                html: cuscode,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#00a65a',
                cancelButtonColor: '#d33',
                confirmButtonText: '<i class="fa fa-check"></i> ใช่',
                cancelButtonText: '<i class="fa fa-times"></i> ไม่',
                allowOutsideClick: false,
                focusConfirm: false,
            }).then((result) => {
                if (result.value) {//ยกเลิก
                    $('.select_promotion_' + cuscode + '_' + promotioncode + '_' + promotionseq).attr('data-valuepack', 0);
                    $('.select_promotion_' + cuscode + '_' + promotioncode + '_' + promotionseq).attr('data-valuepacksumamt', 0);
                } else {//ไม่ยกเลิก
                    $('.select_promotion_' + cuscode + '_' + promotioncode + '_' + promotionseq).prop('checked', true);
                }
            });

        }
    });

