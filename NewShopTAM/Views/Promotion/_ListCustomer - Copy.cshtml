<div class="card-footer p-2">
    <div class="row" style="margin-top: -10px;">
        <div class="col-12">
            <div class="card mb-12 mt-2">
                <div class="card-header text-black font-weight-bold" style="background-color: #f9dfbf;">
                    <div class="row">
                        <div class="col-xs-8 col-sm-8 col-md-8 text-left">
                            <sapn> @ViewBag.textHeader </sapn>  <span class="label label-warning"> <span id="countCustomer"> @ViewBag.countCustomer </span>/ <span id="countCustomerReg"> @ViewBag.countCustomerReg </span> </span> &nbsp;
                        </div>
                        <div class="col-xs-4 col-sm-4 col-md-4 text-right">
                            <span> <button class="btn btn-xs btn-info" onclick="showCustomerSearch();" style="cursor: pointer; font-weight: bold;"> <span> <i class="fa fa-search"> </i> ร้านค้า </span> </button> </span>
                            &nbsp; @*<button class="btn btn-md btn-success" onclick="saveCustomerRegister();" style="margin: -2px; border: solid 2px #1b9f1b; font-weight: bold;"> <i class="fa fa-save"> </i> บันทึก </button>*@
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row" style="position: sticky; top: 0; z-index: 1; padding-left: 10px; display: none; padding : 10px;" id="headerSearchCustomer">
                        <div class="col-xs-6 col-sm-6 col-md-6">
                            <div class="input-group">
                                <input type="text" class="form-control" name="customerSearch" id="customerSearch" value="" style="min-height: 40px;" autocomplete="off" placeholder="กรอกรหัสหรือชื่อร้านค้าที่ต้องการค้นหา" />
                                <span class="input-group-addon" style="background-color: #6e7071; padding-right: 25px;" role="button" onclick="resetCustomerSearch()">
                                    <span style="color: #ffffff">
                                        <i class="fa fa-times" style="font-weight: bold;"></i>
                                    </span>
                                </span>
                            </div>
                        </div>
                    </div>
                    <ul id="listCustomer" class="list-group list-group-flush w-100 align-items-stretch" list-style: none>
                        @{
                            int rowList = 1;
                            string classSelectPromotion = "";
                            if (ViewBag.customerRegisterList != null)
                            {
                                foreach (var rowData in ViewBag.customerRegisterList)
                                {
                                    var checkboxChecked = "";
                                    var checkboxDisable = "";
                                    if (!string.IsNullOrEmpty(@rowData.FlagReg))
                                    {
                                        checkboxChecked = "checked";
                                    }
                                    if (!string.IsNullOrEmpty(@rowData.FlagApprove))
                                    {
                                        checkboxDisable = "disabled";
                                    }
                                    classSelectPromotion = "select_promotion_" + @rowData.Cuscode + "_" + @ViewBag.promotionCode + "_" + @ViewBag.promotionSeq;
                                    <li id="list-code-@rowData.Cuscode" class="list-group-item cursor-pointer d-flex justify-content-between align-items-center py-1 pl-3" style="white-space: nowrap;" data-cuscode="@rowData.Cuscode" data-cusname="@rowData.Cusname">
                                        <span class="align-middle textCut" style="padding: 7px;">
                                            <input type="checkbox" name="selectPromotion" id="selectPromotion" class="cursor-pointer @classSelectPromotion" value="@rowData.Cuscode" data-valuepack="@rowData.PackQty" data-valuepacksumamt="@rowData.SumPackAmt" data-promotioncode="@ViewBag.promotionCode" data-promotionseq="@ViewBag.promotionSeq" data-pack="@rowData.PackQty" data-packamt="@rowData.PackAmt" data-sumpack="@rowData.SumPackAmt" data-cuscode="@rowData.Cuscode" data-cusname="@rowData.Cusname" @checkboxChecked @checkboxDisable />
                                            <span class="pl-1">
                                                @rowData.Cuscode (@rowData.Cusname)

                                            </span>
                                            @*กรณีมีลง Pack ไว้ *@
                                             @if (@rowData.PackQty != null && @rowData.PackQty > 0)
                                             {
                                                <span class="label label-warning" onclick="popupAddPack('@rowData.Cuscode', '@rowData.Cusname', '@rowData.PackQty', '@rowData.PackAmt', '@rowData.SumPackAmt', '@ViewBag.promotionCode', '@ViewBag.promotionSeq');" style="padding: 8px; font-size: 14px;">@rowData.PackQty</span>
                                             }
                                        </span>
                                        <span class="list-group-item-heading justify-content-between align-items-center">
                                             @if (@rowData.FlagApprove == "Y")
                                             {
                                                <span class="label label-danger pull-right">รอ Approve</span>
                                             }

                                        </span>
                                    </li>
                                }
                            }
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<script defer>
    //ค้นหาร้านค้า
    $("#customerSearch").on("keyup", function () {
        var value = $(this).val().toLowerCase();
        $("#listCustomer li").each(function () {
            var cusname = $(this).data("cusname").toLowerCase();
            var cuscode = $(this).data("cuscode").toLowerCase();
            if (cusname.indexOf(value) > -1 || cuscode.indexOf(value) > -1) {
                $(this).css("display", "block");  // Show the item
            } else {
                $(this).attr("style", "display: none !important");
            }
        });
    });
    //ปุ่มค้นหาร้านค้า
    function showCustomerSearch() {
        var x = document.getElementById("headerSearchCustomer");
        if (x.style.display === "block") {
            x.style.display = "none";
        } else {
            x.style.display = "block";
            $("#customerSearch").focus();
        }
    }

    function resetCustomerSearch() {
        $('#customerSearch').val('');
        $('#customerSearch').trigger('keyup');
        $('#showSubListCustomer').empty();
        $('#showSubListCustomer').html('<div style="padding: 30px; font-size: 14px;"> <i class="fa fa-spinner fa-spin fa-2x" aria-hidden="true"></i> กำลังโหลดข้อมูล... </div>');
    }
    function calSumPackAmt(packAmt) {
        var packQty = $('#packQty').val();
        var sumPackAmt = 0;//packAmt;
        //var packQtyNumber = parseFloat(packQty) || 0;

        console.log("packQty = " + packQty);
        console.log("packAmt = " + packAmt);

        if (packQty > 0 && packAmt > 0) {
            sumPackAmt = packQty * packAmt;
        }
        $('#sumPackAmt').val(sumPackAmt);
    }
    //Pop up ใส่จำนวนแพ็ค
    function popupAddPack(cuscode, cusname, packqty, packamt, sumpackamt, promotioncode, promotionseq) {
        console.log("popupAddPack");
        var sumpackNew = 0;
        var form = '<form id="form-add-pack" style="text-align: left;">';
        form += '<label> <span class="label label-info">' + promotioncode + '</span> </label> <br>'
        form += '<label>' + cuscode + ' (' + cusname + ')' + '</label> <br>'
        form += '<label>Pack Qty</label> <input type="number" id="packQty" name="packQty" value="' + packqty + '" onkeyup="calSumPackAmt('+ packamt +')" class="form-control" autocomplete="off" style="width:100%;"></input>'
        form += '<label>Amount</label> <input type="text" readonly id="sumPackAmt" name="sumPackAmt" value="' + sumpackamt + '" class="form-control" autocomplete="off" style="width:100%;"></input>'
        form += '</form>';
        Swal.fire({
            //title: 'ยืนยันยกเลิกลีด',
            //icon: 'question',
            html: form,
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'ยืนยัน',
            cancelButtonText: 'ยกเลิก',
            backdrop: true,
            allowOutsideClick: false,
            preConfirm: function () {
                if ($('#packQty').val() == '' || $('#packQty').val() == '0') {
                    Swal.showValidationMessage(
                        'จำนวน Pack ต้องไม่ว่าง'
                    )
                }
            },
            //allowOutsideClick: () => !Swal.isLoading()
        }).then((result) => {
            if (result.value) {
                var packQty = $('#packQty').val() || 0;
                if (packQty > 0 && packamt > 0) {
                    sumpackNew = packQty * packamt;
                    sumpackNew = sumpackNew.toFixed(2);
                }
                $('.select_promotion_' + cuscode + '_' + promotioncode + '_' + promotionseq).attr('data-valuepack', packQty);
                $('.select_promotion_' + cuscode + '_' + promotioncode + '_' + promotionseq).attr('data-valuepacksumamt', sumpackNew);
                //LoadingShow();
                //var arrData = new Array();
                //var remark = $('#remark').val();
