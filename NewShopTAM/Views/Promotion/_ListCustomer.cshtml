        console.log("packAmt = " + packAmt);
        if (packQty > 0 && packAmt > 0) {
            sumPackAmt = packQty * packAmt;
        }
        $('#sumPackAmt').val(sumPackAmt);
    }
    //Modal จัดการ
    function getManagePackPromotion(customerCode, customerName, promotionCode, promotionSeq, packQty, packAmt, sumPackAmt) {
        var slmCode = $("#slmCode option:selected").val();
        var txtHeaderManagePackPromotion = '@ViewBag.textHeader';// customerCode + ' /' + customerName;
        $.ajax({
            url: '@Url.Action("GetManagePackPromotion", "Promotion")',
            data: {
                slmCode: slmCode,
                customerCode: customerCode,
                customerName: customerName,
                promotionCode: promotionCode,
                promotionSeq: promotionSeq
            },
            type: 'POST',
            dataType: 'HTML',
            beforeSend: function () {
                LoadingShow();
                $('#managePackPromotionModal').find('.modal-body').html("");
            },
            success: function (data) {
                //set text header
                $('#managePackPromotionModal .modal-title').text(txtHeaderManagePackPromotion);
                $('#managePackPromotionModal').find('.modal-body').html(data);
                $('#managePackPromotionModal').modal('show');
            },complete: function (res) {
                LoadingHide();
            },
            error: function (er) {
                Swal.fire({
                    icon: 'error',
                    html: '<p>managePackPromotionModal :</p><p>' + er.error + '</p>',
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'ปิด',
                    allowOutsideClick: false,
                    focusConfirm: false,
                });
            }
        }).fail(function (error) {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด กรุณาแจ้งผู้ดูแลระบบ (' + error.status + ')',
                html: '<p>managePackPromotionModal :</p><p>' + error.responseText + '</p>',
                confirmButtonColor: '#d33',
                confirmButtonText: 'ปิด',
                allowOutsideClick: false,
                focusConfirm: false,
            });
        });
    }
