                                confirmButtonColor: '#3085d6',
                                confirmButtonText: 'ปิด',
                                allowOutsideClick: false,
                                focusConfirm: false,
                                timer: 5000,
                                timerProgressBar: true,
                                onClose: () => {
                                    LoadingHide();
                                }
                            });
