                            Swal.fire({
                                icon: 'error',
                                title: 'Error not saved',
                                html: result.status,
                                confirmButtonColor: '#d33',
                                confirmButtonText: 'ปิด',
                                allowOutsideClick: false,
                                focusConfirm: false,
                            });
                        }
