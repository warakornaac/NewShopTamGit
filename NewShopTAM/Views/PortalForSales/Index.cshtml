@{
    ViewBag.Title = "LoginCus";
    string domainName = HttpContext.Current.Request.Url.GetLeftPart(UriPartial.Authority);
}
<html lang="en">
<head>
    <title>Select Customer</title>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <link href="~/Content/styleLogin.css" rel="stylesheet" />
    <link href="~/bootstrap-select-1.13.14/dist/css/bootstrap-select.css" rel="stylesheet" />
    <style>
        a, a:hover {
            color: #333
        }

        .warning-red {
            color: red;
        }

        .red-star {
            color: red;
        }

        .bg-login-color-redient {
            background: linear-gradient(0deg, rgba(255,255,255,1) 0%, rgba(0,123,255,1) 100%);
        }

        .disable-link {
            pointer-events: none;
            cursor: default;
            color: dimgray;
        }
        /**/
        @@import url("https://fonts.googleapis.com/css2?family=Kanit:ital,wght@0,400;0,500;0,600;1,500&display=swap");

        html body {
            font-family: 'Kanit', sans-serif;
        }

        .bootstrap-select > .dropdown-toggle {
            border: 1px solid #ccc !important;
        }
    </style>
</head>
<body class="bg-login-color-redient">
    <div class="wrapper">
        <div class="content-wrapper">
            <div class="form-bg d-flex ">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-md-6 text-center mb-5">
                        </div>
                    </div>
                    <input type="hidden" name="slmcod" id="slm" />
                    <div class="row justify-content-center">
                        <div class="col-md-7 col-lg-5">
                            <div class="wrap">
                                @*<div class="img" style="background-image: url(../../images/bg-1.jpg);"></div>*@
                                <div class="login-wrap p-4 p-md-5">
                                    <div class="d-flex text-center">
                                        <div class="w-100">
                                            <h4 class="font-bold" style="color: #000000;">เลือกลูกค้า</h4>
                                        </div>

                                    </div>
                                    @*<form class="signin-form" action="#" method="post">*@
                                    <div class="form-group">
                                        <label class="control-label" for="sale-man-txt" style="color: #2d6eff; font-weight: bold; font-size: 13px; margin-bottom: 2px;">SALEMAN CODE</label>
                                        <input type="hidden" class="form-control" id="sale-man-txt" name="sale-man" placeholder="SaleMan" readonly>
                                        <select class="form-control selectpicker" data-container="body" data-live-search="true" title="SELECT SALEMAN" data-hide-disabled="true" id="selslm">
                                        </select>
                                        <label class="form-control-placeholder" for="username"></label>
                                        @*<p class="warning-red" id="wronguser" hidden>Username ไม่ถูกต้อง</p>*@
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label mr-1" for="username" style="color: #2d6eff; font-weight: bold; font-size: 13px; margin-bottom: 2px; ">CUSTOMER </label><span class="badge badge-primary" id="count-customer"></span>
                                        <div class="input-group mb-1" id="show_hide_password">
                                            @*<input type="password" class="form-control" id="inputPassword" name="password" placeholder="Password" required>*@
                                            @*<div class="input-group-append ">
                                                    <a href="" class="btn border d-flex align-items-center justify-content-center"><i class="fa fa-eye-slash" aria-hidden="true"></i></a>
                                                </div>*@
                                            <select class="form-control selectpicker" data-container="body" data-live-search="true" title="SELECT CUSTOMER" data-hide-disabled="true" id="selcus">
                                                <option value="110Z0001O" data-name="Tru Automotive (Testing)">
                                                    110Z0001O/Tru Automotive (Testing)
                                                </option>
                                            </select>
                                        </div>
                                        <label class="control-label" for="selcus" id="label-select-customer-zero" style="color:red;" hidden>ไม่พบลูกค้าที่ลงทะเบียน</label>
                                    </div>
                                    <div class="form-group">
                                        <button type="submit" class="form-control btn btn-primary rounded submit px-3" onclick="submitCustomer()">ยืนยัน</button>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="~/bootstrap-select-1.13.14/dist/js/bootstrap-select.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
@*<script src="https://code.jquery.com/jquery-3.2.1.slim.min.js" integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN" crossorigin="anonymous"></script>*@
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js" integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js" integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl" crossorigin="anonymous"></script>
<script type="text/javascript">
    var slm = '@Request.RequestContext.HttpContext.Session["slmcode"]';
    var cuscod = '@Request.RequestContext.HttpContext.Session["CUSCOD"]';
    console.log("CUSCOD Check : " + cuscod);
    const queryString = decodeURIComponent(window.location.search);
    const params = new URLSearchParams(queryString);
    const page = params.get('page');
    if (slm != null) {
        $('#sale-man-txt').val(slm);
        //$('#slm').val(slm);
        getSlmList();
        getCustomerList(slm);
    }
    $(document).ready(function () {
        $('#selslm').on('change', function () {
            const slmcode = $(this).val();
            getCustomerList(slmcode);
        });
    });
    function getSlmList() {
        $.ajax({
            url: '@Url.Action("GetSLMList", "PortalForSales")',
            data: {
                SLM: slm
            },
            type: 'POST',
            dataType: 'JSON',
            success: function (data) {
                if (data.message == 'Y') {
                    var selectSLM = $('#selslm');
                    selectSLM.children().remove();
                    $.each(data.SlmList, function (key, value) {
                        //selectSLM.append()
                        selectSLM.append('<option value="' + value.Value + '" data-name="' + value.Text + '">' + value.Text + '</option>');
                    });
                    $('.selectpicker').selectpicker('refresh');
                    selectSLM.val(slm).change();
                }
                else {
                    console.log("Error :" + data.message);
                }
            }
        })
    }
    function getCustomerList(SLMCOD) {
        $.ajax({
            url: '@Url.Action("GetcustomerList", "PortalForSales")',
            data: {
                SLM: SLMCOD
            },
            type: 'POST',
            dataType: 'JSON',
            success: function (data) {
                if (data.message == 'Y') {
                    if (cuscod == "110Z0001O") {
                        var select = $("#selcus");
                        select.children().remove();
                        select.append('<option value="" data-name="เลือกลูกค้า" disabled> เลือกลูกค้า </option>')
                        select.append($("<option>").val("110Z0001O").attr("data-name", "Tru Automotive (Testing)").text("110Z0001O/Tru Automotive (Testing)"));
                        $('.selectpicker').selectpicker('refresh');
                        select.val("110Z0001O").change();
                    }
                    else {
                        console.log(data.CUSList);
                        var select = $("#selcus");
                        select.children().remove();
                        //select.append($("<option>").val("110Z0001O").attr("data-name", "Tru Automotive (Testing)").text("110Z0001O/Tru Automotive (Testing)"));
                        $.each(data.CUSList, function (key, value) {
                            select.append('<option value="' + value.CUSCOD + '" data-name="' + value.CUSNAM + '">' + value.CUSCOD + '|' + value.CUSNAM + '</option>');
                        });
                        $('.selectpicker').selectpicker('refresh');
                        select.val(cuscod).change();
                        if (data.CUSList.length == 0) {
                            $('#label-select-customer-zero').removeAttr('hidden');
                        }
                        else {
                            $('#label-select-customer-zero').attr('hidden',true);
                        }
                        $('#count-customer').text(data.CUSList.length);


                    }

                }
                else {
                    console.log('Error : ' + data.message);
                }
            }
        });
    }

    function submitCustomer() {
        var selectCus = $('#selcus').val();
        console.log("Select CUSCOD VAL :" + selectCus);
        if (selectCus != "") {
            $.ajax({
                url: '@Url.Action("CustomerSelected", "PortalForSales")',
                data: {
                    CUSCOD: selectCus
                },
                type: 'POST',
                dataType: 'JSON',
                success: function (data) {
                    if (data.message == "Y") {
                        window.location.href = "../CustomerDashboard/CustomerMenu";
                    }
                    else {
                        Swal.fire({
                            title: "Warning",
                            text: "กรุณาเลือกลูกค้า",
                            icon: "warning"
                        });
                    }

                }
            });
        }
        else {
            Swal.fire({
                title: "Warning!",
                text: "กรุณาเลือกลูกค้าที่ต้องการ!",
                icon: "warning"
            });
        }
    }
</script>


