@{
    ViewBag.Title = "RegisterCustomer";
    Layout = "~/Views/Shared/_Layoutcus_center.cshtml";
    List<SelectListItem> getSlmCodeList = ViewBag.slmCodeList;
    List<SelectListItem> getPmCodeList = ViewBag.pmCodeList;
}
<html>
<head>
    <meta charset="utf-8">
    <title>Register Promotion</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <script src="~/Scripts/jquery-2.2.4.js"></script>
    <script src="~/contentfilter/js/jquery.mixitup.min.js"></script>
    <link href="~/Content/Normalize.css" rel="stylesheet" />
    <link href="~/bootstrap-select-1.13.14/dist/css/bootstrap-select.css" rel="stylesheet" />
    <script src="~/Scripts/bootstrap.bundle.min.4.5.0.js"></script>
    <script src="~/Scripts/bootstrap-select.min.1.13.17.js"></script>
    <script src="~/Scripts/sweetalert2/sweetalert2.min.js"></script>
    <link href="~/Scripts/sweetalert2/sweetalert2.min.css" rel="stylesheet">
    <script src="~/Scripts/loadingoverlay.min.js"></script>
</head>
<body>
    <div class="container-fluid mt--90">
        <div class="row">
            <div class="col-12">
                <div class="card mb-12 mt-4">
                    <form action="" id="forecastPmForm" method="post" onsubmit="">
                        <div class="card-header bg-primary text-white font-weight-bold" onclick="hideHeader();" style="cursor: pointer;">
                            <div class="row">
                                <div class="col-sm-12">
                                    <i class="fa fa-table"></i> Customer register promotion
                                </div>
                            </div>
                        </div>
                        <div class="card-body" id="headerSearch">
                            <div class="row p-2">
                                <div class="col-sm-3 col-md-3">
                                    <div class="form-group">
                                        <span> <i class="fa fa-user"></i><b> SLMCODE:</b></span>
                                        <span>
                                            <select class="form-control selectpicker" id="slmCode" name="slmCode" style="width: 100%;" data-live-search="true" data-none-selected-text="SELECT SLMCODE">
                                                @for (var i = 0; i < getSlmCodeList.Count; i++)
                                                {
                                                    <option value="@getSlmCodeList[i].Value">@getSlmCodeList[i].Text</option>
                                                }
                                            </select>
                                        </span>
                                    </div>
                                </div>
                                <div class="col-sm-3 col-md-3">
                                    <div class="form-group">
                                        <span> <i class="fa fa-university"></i><b> COMPANY:</b></span>
                                        <span>
                                            <select class="form-control selectpicker" id="company" name="company" style="width: 100%;">
                                                <option value="ALL" selected>ALL</option>
                                                <option value="TAC">TAC</option>
                                                <option value="AAC">AAC</option>
                                                <option value="OMP">OMP</option>
                                            </select>
                                        </span>
                                    </div>
                                </div>
                                <div class="col-sm-3 col-md-3">
                                    <div class="form-group">
                                        <span> <i class="fa fa-calendar"></i><b> YEAR:</b></span>
                                        <span>
                                            <select class="form-control selectpicker" id="year" name="year" style="width: 100%;">
                                                <option value="2025">2025</option>
                                                <option value="2024" selected>2024</option>
                                                <option value="2023">2023</option>
                                            </select>
                                        </span>
                                    </div>
                                </div>
                                <div class="col-sm-3 col-md-3">
                                    <div class="form-group">
                                        <span> <i class="fa fa-calendar"></i><b> PERIOD:</b></span>
                                        <span>
                                            <select class="form-control selectpicker" id="period" name="period" style="width: 100%;" data-live-search="true" data-none-selected-text="SELECT PERIOD">
                                                <option value="ALL" selected>ALL</option>
                                                <option value="Yearly">Yearly</option>
                                                <option value="Half Year">Half Year</option>
                                                <option value="Quarter">Quarter</option>
                                                <option value="Monthly">Monthly</option>
                                                <option value="Other">Other</option>
                                            </select>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="row p-2">
                                <div class="col-sm-3 col-md-3">
                                    <div class="form-group">
                                        <span> <i class="fa fa-user"></i><b> PROD MGR:</b></span>
                                        <span>
                                            <select class="form-control selectpicker" id="prodMgr" name="prodMgr" style="width: 100%;" data-live-search="true" data-none-selected-text="SELECT PROD MGR">
                                                <option value="ALL" selected>ALL</option>
                                                @for (var i = 0; i < getPmCodeList.Count; i++)
                                                {
                                                    <option value="@getPmCodeList[i].Value">@getPmCodeList[i].Text</option>
                                                }
                                            </select>
                                        </span>
                                    </div>
                                </div>
                                <div class="col-sm-9 col-md-9">
                                    <div class="form-group">
                                        <span> <i class="fa fa-tag"></i><b> PROMOTION CODE:</b></span>
                                        <span>
                                            <select class="form-control selectpicker" id="promotionCode" name="promotionCode" style="width: 100%;" data-live-search="true" data-none-selected-text="SELECT PROMOTION CODE">
                                            </select>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer" id="headerSearchFooter">
                            <div class="row">
                                <div class="col-md-12 text-right" style="font-size: 14px; color: red; white-space: nowrap;">
                                    @*<button type="reset" class="btn btn-default btn-md" onclick="resetSearch();" style="font-size: medium;"><i class="fa fa-refresh"></i> Reset</button> &nbsp;
                                        <button type="button" class="btn btn-primary btn-md" onclick="searchPromotionReg();" style="font-size: medium;"><i class="fa fa-search"></i> Search</button>*@
                                    ระบบจะแสดงรายละเอียดเมื่อเลือก Promotion code
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        @{
            @*if (((List<StoreSearchBudgetSaleModel>)ViewBag.stkGroupList).Count() != 0)
                {
                    <div class="col-xs-12 col-md-12 col-lg-6 alert alert-danger alert-dismissible fade show text-left" style="font-size: 18px; font-weight: bold;"> <button type="button" class="close" data-dismiss="alert">&times;</button> <i class="fa fa-exclamation-circle" aria-hidden="true"></i> Budget กรอกข้อมูลได้ช่วงวันที่ @ViewBag.startDate ถึง @ViewBag.endDate เท่านั้น</div>
                }*@
        }
        <div id="showDetailPromotionRegister" class="pt-1 pb-1"></div>

    </div>
</body>
</html>
<script defer>
    var userType = @this.Session["UserType"].ToString();
    $(document).ready(function () {
        //เลือก Company
        $('#slmCode').change(function () {
            var promotionCode = $("#promotionCode option:selected").val();
            var slmCode = $(this).val();
            if (promotionCode != undefined && slmCode != "") {
                searchPromotionReg(promotionCode);
            }
        });
        //เลือก Company
        $('#company').change(function () {
            var period = $("#period option:selected").val();
            var prodMgr = $("#prodMgr option:selected").val();
            var year = $("#year option:selected").val();
            var company = $(this).val();
            GetPromotion(prodMgr, year, company, period);
        });
        //เลือก Year
        $('#year').change(function () {
            var period = $("#period option:selected").val();
            var prodMgr = $("#prodMgr option:selected").val();
            var year = $(this).val();
            var company = $("#company option:selected").val();
            GetPromotion(prodMgr, year, company, period);
        });
        //เลือก Period
        $('#period').change(function () {
            var period = $(this).val();
            var prodMgr = $("#prodMgr option:selected").val();
            var year = $("#year option:selected").val();
            var company = $("#company option:selected").val();
            GetPromotion(prodMgr, year, company, period);
        });
        //เลือก PM
        $('#prodMgr').change(function () {
            var period = $("#period option:selected").val();
            var prodMgr =  $(this).val();
            var year = $("#year option:selected").val();
            var company = $("#company option:selected").val();
            GetPromotion(prodMgr, year, company, period);
        });
        //เลือก Promotion code
        $('#promotionCode').change(function () {
            var promotionCode = $(this).val();
            if (promotionCode != undefined) {
                searchPromotionReg(promotionCode);
            }
        });
    });
    //ดึง promotion code
    function GetPromotion(prodMgr, year, company, period) {
        if (prodMgr == null || prodMgr == '') {
            prodMgr = 0;
        }
        if (year == null || year == '') {
            year = 0;
        }
        console.log("prodMgr = " + prodMgr + " year = " + year.slice(-2) + " company = " + company + " period = " + period);
        $.ajax({
            url: '@Url.Action("GetPromotion", "Promotion")',
            data: {
                prodMgr: prodMgr,
                year: year.slice(-2),
                company: company,
                period: period
            },
            type: "POST",
            dataType: "JSON",
            beforeSend: function () {
                //LoadingShow();
            },
            success: function (data) {
                var select = $("#promotionCode");
                select.children().remove();
                //select.append($("<option>").val("ALL").text("STOCK GROUP ALL"));
                $(data).each(function (index, item) {
                    select.append($("<option>").val(item.PromotionCode).text(item.PromotionCode + " / " + item.PromotionDes));
                });
                $('#promotionCode').selectpicker('refresh');
                $('#promotionCode').selectpicker('selectAll');
                //$('#promotionCode').trigger('change');
                setTimeout(() => {
                    promotionCode = $("#promotionCode option:selected").val();
                    if (promotionCode != undefined) { //ถ้าเจอโปโมรชั่น
                        searchPromotionReg(promotionCode);
                    } else {
                        $('#showDetailPromotionRegister').empty();
                    }
                }, "1000");
            }
        });
    }
    //search detail promotion
    function searchPromotionReg(promotionCode) {
        //$("#slmCode").prop('disabled', false);
        var msg = '';
        var error = 0;
        var slmCode = $("#slmCode option:selected").val();
        var prodMgr = $("#prodMgr option:selected").val();
        var year = $("#year option:selected").val();
        var company = $("#company option:selected").val();
        //var promotionCode = $("#promotionCode option:selected").val();
        var promotionText = $("#promotionCode option:selected").text();
        if (prodMgr == undefined) {
            ++error;
            msg += '<br>' + error + '. กรุณาเลือก Prod MGR';
        }
        if (year == undefined) {
            ++error;
            msg += '<br>' + error + '. กรุณาเลือก ปี';
        }
        if (company == undefined) {
            ++error;
            msg += '<br>' + error + '. กรุณาเลือก Company';
        }
        if (promotionCode == undefined || promotionCode == "") {
            ++error;
            msg += '<br>' + error + '. กรุณาเลือก Promotion Code';
        } else {
            //$("#txtHeadPromotionDetail").text(promotionText);
        }
        //console.log("stksec = " + stksec);
        //return false;
        if (error) {
            Swal.fire({
                icon: 'warning',
                title: 'กรุณาตรวจสอบข้อมูลต่อไปนี้',
                html: msg,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Close',
                allowOutsideClick: false,
                focusConfirm: false,
            });
            return false;
        } else {
            $.ajax({
                type: 'post',
                url: '@Url.Action("GetPromotionDetail", "Promotion")',
                data: {
                    promotionCode: promotionCode,
                    slmCode: slmCode
                },
                dataType: 'html',
                cache: false,
                Async: true,
                beforeSend: function () {
                    $('#showDetailPromotionRegister').empty();
                    //$('#showDetailPromotionRegister').html('<div style="padding: 30px; font-size: 14px;"> <i class="fa fa-spinner fa-spin fa-2x" aria-hidden="true"></i> กำลังโหลดข้อมูล... </div>');
                    LoadingShow();
                },
                success: function (res) {
                    $('#showDetailPromotionRegister').html(res);
                    $("#txtHeadPromotionDetail").text(promotionText);
                    LoadingHide();
                },
                error: function (er) {
                    alert(er.error);
                }
            }).fail(function (error) {
                LoadingHide();
                Swal.fire({
                    icon: 'error',
                    title: 'Error not search',
                    html: 'กรุณาแจ้งผู้ดูแลระบบ<br>โดยการแคปหน้าจอและก๊อปปี้ Error ด่านล่างนี้<br>searchPromotionReg<br><br>',
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'ปิด',
                    allowOutsideClick: false,
                    focusConfirm: false,
                });
            });
        }
    }
    function resetSearch() {
        LoadingShow();
        location.reload();
        LoadingHide();
    }

    document.onreadystatechange = function () {
        if (document.readyState === 'interactive') {
            //LoadingShow();
        }
        if (document.readyState === "complete") {
            //$('#slmCode').selectpicker('val', '');
            $('#prodMgr').selectpicker('val', '');

            if (userType == 3) {
                $("#slmCode").prop('disabled', true);
            }
        }
    }

    function LoadingShow() {
        $.LoadingOverlay("show");
    }

    function LoadingHide() {
        $.LoadingOverlay("hide");
    }
</script>
