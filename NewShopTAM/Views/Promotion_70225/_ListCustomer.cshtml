    .list-group {
        max-height: 520px;
        margin-bottom: 10px;
        overflow: scroll;
        -webkit-overflow-scrolling: touch;
        font-size: 14px;
    }

    @@media screen and (max-width: 576px) {
        .textCut {
            /*display: inline-block;*/
            /*width: 350px;*/
            white-space: nowrap;
            overflow: hidden !important;
            text-overflow: ellipsis;
        }
