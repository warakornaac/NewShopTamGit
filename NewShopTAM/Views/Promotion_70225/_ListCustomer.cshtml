    function dropdownGetCustomerByCuscode(cusCodeSearch) {
        console.log("dropdownGetCustomerByCuscode = Current");
         if (cusCodeSearch == 'ALL') {
             $('#cusCodeSearch').selectpicker('val', 'ALL');
        }
        getSubCustomerByPromotion(cusCodeSearch);
    }

    //get list customer
    function getSubCustomerByPromotion(cusCodeSearch) {
        console.log("getSubCustomerByPromotion = Current");
        var cusCodeSearchTxt = 'ALL';
        if (cusCodeSearch || cusCodeSearch != 'ALL') {
            cusCodeSearchTxt = cusCodeSearch
        }
        var slmCode = $("#slmCode option:selected").val();
        var promotionCode = $("input[name=selectPromotionSub]:checked").data('code');
        var promotionSeq = $("input[name=selectPromotionSub]:checked").data('seq');
        $.ajax({
            type: 'post',
            url: '@Url.Action("GetSubCustomerByPromotion", "Promotion")',
            data: {
                slmCode: slmCode,
                promotionCode: promotionCode,
                promotionSeq: promotionSeq,
                cusCodeSearch: cusCodeSearchTxt,
                //textHeader: textHeaderDetailPromotion
            },
            dataType: 'html',
            cache: false,
            Async: true,
            beforeSend: function () {
                $('#showSubListCustomer').empty();
                $('#showSubListCustomer').html('<div style="padding: 30px; font-size: 14px;"> <i class="fa fa-spinner fa-spin fa-2x" aria-hidden="true"></i> กำลังโหลดข้อมูล... </div>');
                // LoadingShow();
            },
            success: function (res) {
                // LoadingHide();
                $('#showSubListCustomer').html(res);
                //$('#cusCodeSearch').selectpicker('refresh');
                $('#cusCodeSearch').selectpicker({
                    //style: 'btn-primary',
                    //size: 2
                });
            },
            error: function (er) {
                alert(er.error);
            }
        }).fail(function (error) {
            Swal.fire({
                icon: 'error',
                title: error.status,
                html: 'กรุณาแจ้งผู้ดูแลระบบ<br>โดยการแคปหน้าจอและก๊อปปี้ Error ด่านล่างนี้<br>radioSelectPromotionSub<br><br>',
                confirmButtonColor: '#d33',
                confirmButtonText: 'ปิด',
                allowOutsideClick: false,
                focusConfirm: false,
            });
        });
    }
