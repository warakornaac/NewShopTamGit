<script>
    async function getReceiptInsurePayment() {
        try {
            let company_id = $('#company_id').val() || '';
            let setUrl = `${baseUrl}/dashboard/receive-insure/get-receipt-insure-payment`;
            let params = { company_id };
            let headers = {
                'accept': '*/*',
                'content-type': 'application/json'
            };

            const result = await axios.get(setUrl + '?company_id=' + company_id); // กรณี GET
            // const result = await axios.post(setUrl, params, headers); // กรณี POST
            // console.log(result);
            let { data } = result;
            $('#last_update_page').text(data.last_update_page);
            $('#insure_sales_goal').text(data.goal_amt);
            $('#receive_date').text(data.receive_date);
            $('#receive_month').text(data.receive_month);
            return data;
        } catch (error) {
            console.log(error);
        }
    }
</script>
