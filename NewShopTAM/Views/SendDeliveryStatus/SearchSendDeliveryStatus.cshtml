<h2>SearchSendDeliveryStatus</h2>
<div class="content-wrapper" style="padding-top: 50px;">
    <div class="row justify-content-center">
        <div class="col-md-10 col-sm-12">
            @*ประวัติการเคลม*@
            <div class="card">
                <h5 class="card-header"><b><i class="fa fa-list"></i> List Order</b></h5>
                <div class="card-body" style="padding: 0px 0px;">
                    <div class="table-responsive">
                        <table class="table dataTable table-striped table-bordered nowrap table-hover" width="100%" style="margin-bottom: 0px;">
                            <thead>
                                <tr class="bg-primary">
                                    <th></th>
                                    <th>#</th>
                                    <th class="text-center"><b>UID</b></th>
                                    <th class="text-center"><b>เลขที่เอกสาร</b></th>
                                    <th class="text-center"><b>วันที่ส่ง</b></th>
                                    <th class="text-center"><b>ชื่อร้าน</b></th>
                                    <th class="text-center"><b>สถานะส่งสินค้า</b></th>
                                    <th class="text-center"><b>Send message</b></th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int rowShop = 1;
                                    foreach (var rowListData in ViewBag.listData)
                                    {
                                        <tr>
                                            <td class="text-center"> <button type="button" class="btn btn-sm btn-info" style="cursor:pointer;" onclick="getDataDelivery('@rowListData.Uid', '@rowListData.Docno', '@rowListData.Docdate', '@rowListData.Cusname', '@rowListData.Delivery')"><i class="fa fa-eye"></i></button></td>
                                            <td class="text-center">@rowShop</td>
                                            <td>@rowListData.Uid</td>
                                            <td>@rowListData.Docno</td>
                                            <td>@rowListData.Docdate</td>
                                            <td>@rowListData.Cusname</td>
                                            <td>@rowListData.Delivery</td>
                                            <td class="text-center"></td>
                                        </tr>
                                        rowShop++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @*show detail before send*@
    <div class="row justify-content-center" style="padding-top: 5px;">
