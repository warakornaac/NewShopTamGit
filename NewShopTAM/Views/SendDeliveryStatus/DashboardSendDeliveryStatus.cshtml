<script>
    function scrollSmoothToBottom() {
        $('.tableFixHead').animate({ scrollTop: 1300 }, 60000, function () {
            $('.tableFixHead').animate({ scrollTop: 0 }, 0);
            scrollSmoothToBottom();
        });
    }
    //data table list last
    async function GetListOrderLast() {
        console.log("GetListOrderLast");
        try {
            $.ajax({
                type: 'post',
                url: '@Url.Action("GetStoreSearchOrderNotify", "SendDeliveryStatus")',
                data: {},
                dataType: 'json',
                beforeSend: function () {

                }, success: function (data) {
                    if (data.length > 0) {
                        var rowCount = 1;
                        var htmlTable = "";
                        for (var i = 0; i < data.length; i++) {
                            //console.log(data[i]);
                            htmlTable += "<tr>";
                            htmlTable += "<td class='text-center'>" + (rowCount++) + "</td>";
                            htmlTable += "<td class='text-center'>" + data[i].Uid + "</td>";
                            htmlTable += "<td>" + data[i].Docno + "</td>";
                            htmlTable += "<td>" + data[i].Docdate + "</td>";
                            htmlTable += "<td>" + data[i].Cusname + "</td>";
                            htmlTable += "<td>" + data[i].Delivery + "</td>";
                            // htmlTable += "<td class='text-center'>" + '' + "</td>";
                            htmlTable += "</tr>";
                        }
                        if ((rowCount - 1) > 0) {
                            $('#countRowSuccess').text((rowCount - 1) + " row");
                        } else {
                            $('#countRowSuccess').text("0 row");
                        }

                        $('#listOrderLast  tbody:last-child').html("");
                        $('#listOrderLast  tbody:last-child').prepend(htmlTable);
                        setTimeout(function () {
                            //scrollSmoothToBottom();
                        }, 700);
                    }
                }
            });
        } catch (error) {
            console.log(error);
        }
    }
    //data count
    async function GetSendDeliveryCount() {
        console.log("GetSendDeliveryCount");
        try {
            $.ajax({
                type: 'post',
                url: '@Url.Action("GetStoreSearchOrderNotifyCount", "SendDeliveryStatus")',
                data: {},
                dataType: 'json',
                beforeSend: function () {

                },
                success: function (data) {
                    //console.log(data[0].sumOrderAll);
                    $('#sumOrderAll').text(data[0].sumOrderAll);
                    $('#sumOrderCurrentDate').text(data[0].sumOrderCurrentDate);
                    $('#sumOrderByMonth').text(data[0].sumOrderByMonth);
                    $('#sumOrderStatus1').text(data[0].sumOrderStatus1);
                    $('#sumOrderStatus2').text(data[0].sumOrderStatus2);
                    $('#sumOrderStatus3').text(data[0].sumOrderStatus3);
                    $('#sumOrderStatus4').text(data[0].sumOrderStatus4);
                    $('#sumDateCurrent').text(data[0].sumDateCurrent);
                }
            }).fail(function (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'ระบบทำงานผิดพลาด()',
                    html: 'กรุณาแจ้งผู้ดูแลระบบ<br>โดยการแคปหน้าจอและก๊อปปี้ Error ด่านล่างนี้<br>saveForecastSale<br>' + error.responseText + '<br><br>',
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'ปิด',
                    allowOutsideClick: false,
                    focusConfirm: false
                });
            });
        } catch (error) {
            Swal.fire({
                icon: 'error',
                title: 'ระบบทำงานผิดพลาด()',
                html: 'กรุณาแจ้งผู้ดูแลระบบ<br>โดยการแคปหน้าจอและก๊อปปี้ Error ด่านล่างนี้<br>saveForecastSale<br>' + erroพ + '<br><br>',
                confirmButtonColor: '#d33',
                confirmButtonText: 'ปิด',
                allowOutsideClick: false,
                focusConfirm: false
            });
        }
    }
    //นับเวลา refresh
    fiveMinutes = 60 * 1,
    display = document.querySelector('#countDown');
    var timer;
    function startTimer(duration, display) {
        timer = duration;
        var minutes, seconds;
        setInterval(function () {
            minutes = parseInt(timer / 60, 10)
            seconds = parseInt(timer % 60, 10);

            minutes = minutes < 10 ? "0" + minutes : minutes;
            seconds = seconds < 10 ? "0" + seconds : seconds;

            display.textContent = minutes + ":" + seconds;

            if (--timer < 0) {
                timer = duration;
            }
        }, 1000);
    }
    function resetTimer() {
        timer = 60 * 1;
    }

    async function getReloadDashboard() {
        const countData = await GetSendDeliveryCount();
        const listlLastData = await GetListOrderLast();
        //resetTimer();

        //if (countData.isdata == true) {
        //    setTimeout(async function () {
        //        await GetSendDeliveryCount();
        //    }, 60000); // 1minute
        //}
        startTimer(fiveMinutes, display);
        setTimeout(function () {
            $('#sumOrderAll').html("<div class='spinner-border'></div>");
            $('#sumOrderCurrentDate').html("<div class='spinner-border'></div>");
            $('#sumOrderByMonth').html("<div class='spinner-border'></div>");
            $('#sumOrderStatus1').html("<div class='spinner-border'></div>");
            $('#sumOrderStatus2').html("<div class='spinner-border'></div>");
            $('#sumOrderStatus3').html("<div class='spinner-border'></div>");
            $('#sumOrderStatus4').html("<div class='spinner-border'></div>");
            $('#sumDateCurrent').html("<div class='spinner-border'></div>");
            //set reload table
            $('#listOrderLast  tbody:last-child').html("");
            $('#listOrderLast  tbody:last-child').prepend("<tr><td colspan = '6' class= 'text-center' > <div class='spinner-border'></div> กำลังโหลดข้อมูล ... </td ></tr>");
            getReloadDashboard();
        }, 900000); //1 minute = 60000, 5 minute = 300000, 15 minute = 900000
    }

    $(function () {
        getReloadDashboard();
    });
</script>
