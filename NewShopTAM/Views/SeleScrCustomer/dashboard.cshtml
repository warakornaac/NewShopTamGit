        function commaSeparateNumber(val) {

            if (val === undefined || val === null || val === '') {
                return '';
            }

            val = val.toString();

            while (/(\d+)(\d{3})/.test(val)) {
                val = val.replace(/(\d+)(\d{3})/, '$1' + ',' + '$2');
            }

            return val;
        }
