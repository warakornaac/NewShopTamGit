<!doctype html>
<html class="no-js" lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" type="image/x-icon" href="images/favicon.ico">
    <link rel="apple-touch-icon" href="apple-touch-icon.png">
    <link href="~/features/css/coomingson.css" rel="stylesheet" />
    <link href="~/Content/Normalize.css" rel="stylesheet" />
    <script src="~/CSS/jQueryv3.1.1.js"></script>
    <link rel="stylesheet" href="~/tmartcss/css/shortcode/shortcodes.css">
    <link rel="stylesheet" href="~/tmartcss/css/owl.carousel.min.css">
    <link rel="stylesheet" href="~/tmartcss/css/owl.theme.default.min.css">
    <link rel="stylesheet" href="~/tmartcss/css/core.css">
    <link rel="stylesheet" href="~/tmartcss/css/shortcode/shortcodes.css">
    <link rel="stylesheet" href="~/tmartcss/style.css">
    <link rel="stylesheet" href="~/tmartcss/css/responsive.css">
    <link rel="stylesheet" href="~/tmartcss/css/custom.css">
    <script src="~/tmartcss/js/vendor/modernizr-2.8.3.min.js"></script>
    <script src="~/tmartcss/js/vendor/jquery-1.12.0.min.js"></script>

    <style>
        .header {
            background: linear-gradient(-180deg,#ef3b13fa,#1a30d0a3);
            font-size: 12px;
        }

        #menu {
            position: fixed;
            right: 0;
            top: 50%;
            width: 17em;
            margin: -2.5em 0 0 0;
            z-index: 5;
            background: hsla(80, 90%, 40%, 0.7);
            color: white;
            font-weight: bold;
            font-size: small;
            text-align: left;
            border: solid hsla(80, 90%, 40%, 0.5);
            border-right: none;
            padding: 0.5em 0.5em 0.5em 2.5em;
            box-shadow: 0 1px 3px black;
            border-radius: 3em 0.5em 0.5em 3em;
        }

        #countsku {
            position: absolute;
            top: 0px;
            right: 0px;
            text-align: center;
            font-size: 20px;
            padding: 1px 7px;
            line-height: 0.9;
            background-color: #333;
            border-radius: 0.25em;
        }
    </style>
</head>

<body>
    <!--=================== Header =======================-->
    <header class="header">
        <nav class="navbar navbar-toggleable-sm navbar-light pt-0 pb-0">
            <button class="navbar-toggler navbar-toggler-right" type="button" data-toggle="collapse" data-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <a class="navbar-brand p-0 mr-5" href="#"><img src="~/images/logo/AACTAC185x70.jpg" /></a>
            <div class="float-left"> <a href="#" class="button-left"><span class="fa fa-fw fa-bars "></span></a> </div>
            <div class="collapse navbar-collapse flex-row-reverse" id="navbarNavDropdown">
                <ul class="navbar-nav">
                    @if (Session["UserType"].ToString() != "5")
                    {
                        if (Session["UserType"].ToString() == "1")
                        {
                            <li class="nav-item dropdown messages-menu">
                                <a class="nav-link dropdown-toggle" id="nextcheckstock">Check Inventory Stock</a>
                            </li>
                            <li class="nav-item dropdown messages-menu">
                                <a class="nav-link dropdown-toggle" id="nextcrm">CRM</a>
                            </li>
                            <li class="nav-item dropdown messages-menu">
                                <a class="nav-link dropdown-toggle" id="nextbck">Back Order</a>
                            </li>
                            <li class="nav-item dropdown messages-menu">
                                <a class="nav-link dropdown-toggle" id="btnstatus">My Order</a>
                            </li>
                            <li class="nav-item dropdown messages-menu">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarshowdetail" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <i class="fa fa-shopping-cart" style="font-size: 1.7em;"></i>
                                    <span class="label label-success bg-success" id="countsku"></span>
                                    <span>Shopping Cart</span>
                                </a>
                            </li>
                            <li class="nav-item dropdown messages-menu">

                                <a class="nav-link dropdown-toggle" id="btndetail">Customer Account</a>
                            </li>
                        }
                        else if (Session["UserType"].ToString() == "2")
                        {
                            <li class="nav-item dropdown messages-menu">
                                <a class="nav-link dropdown-toggle" id="btnstatus">My Order</a>
                            </li>
                            <li class="nav-item dropdown messages-menu">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarshowdetail" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <i class="fa fa-shopping-cart" style="font-size: 1.7em;"></i>
                                    <span class="label label-success bg-success" id="countsku"></span>
                                    <span>Shopping Cart</span>
                                </a>
                            </li>
                            <li class="nav-item dropdown messages-menu">
                                <a class="nav-link dropdown-toggle" id="btndetail">Customer Account</a>
                            </li>
                        }
                    }

                    else if (Session["UserType"].ToString() == "5")
                    {
                        <li class="nav-item dropdown messages-menu">

                            <a class="nav-link dropdown-toggle" href="~/Promotion/ApproveChangeCustomer">Approve Promotion Change</a>
                        </li>
                        <li class="nav-item dropdown messages-menu">

                            <a class="nav-link dropdown-toggle" href="https://app.powerbi.com/view?r=eyJrIjoiZGZhMzcyZDQtNjE2ZC00NWIxLTk0NGMtMzM1NDJlYmIxZTY2IiwidCI6IjBjYzc5Nzg2LTAxMWItNDkwOS1hYjNjLTFlMDJjOTRmYTRmZSIsImMiOjEwfQ%3D%3D" target="_blank">Dashboard Event</a>
                        </li>
                        <li class="nav-item dropdown messages-menu">

                            <a class="nav-link dropdown-toggle" href="~/Orderlist/Index">Shopping</a>
                        </li>
                        <li class="nav-item dropdown messages-menu">

                            <a class="nav-link dropdown-toggle" href="~/SCStockSco/Index">Check Product Stock</a>
                        </li>
                        <li class="nav-item dropdown messages-menu">

                            <a class="nav-link dropdown-toggle" href="~/PriceApproval/Index">Approve Pricing</a>
                        </li>
                        <li class="nav-item dropdown messages-menu">
                            <a class="nav-link dropdown-toggle" href="~/Promotion/ApproveChangeCustomer">Approve Promotion Change</a>
                        </li>
                    }
                    <li class="nav-item dropdown messages-menu">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarcart" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
                        </div>
                    </li>
                    <li class="nav-item dropdown  user-menu ">
                        <a class="nav-link dropdown-toggle" href="" id="navbarDropdownMenuLink" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">

                            @if (Session["UserType"].ToString() != "6")
                            {
                                <span class="toggle__menu hidden-xs">Profile @Session["UserID"]  </span>
                            }
                            else if (Session["UserType"].ToString() == "6")
                            {
                                <span class="toggle__menu hidden-xs">Profile @Session["UserID"]  </span>
                            }
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
                            @if (Session["UserType"].ToString() == "5")
                            {
                                <a class="dropdown-item" href="~/Orderlist/Index">Home</a>
                            }
                            else if (Session["UserType"].ToString() != "5")
                            {
                            }
                        </div>
                    </li>
                    <li class="nav-item dropdown messages-menu">
                        <a class="nav-link dropdown-toggle" href="~/Account/LogOut">Logout</a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>
    @RenderBody()
    <script src="~/bootstrap-select-1.13.14/Bootstrapv4.1.0.js"></script>
</body>
</html>