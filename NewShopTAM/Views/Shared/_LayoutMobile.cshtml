        }

        .footer {
            position: fixed;
            left: 0;
            bottom: 0;
            width: 100%;
            color: white;
            text-align: center;
        }

        .logo-img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
        }

        @@media only screen and (max-width: 574px) {
            .logo-img {
                width: 25px;
                height: 25px;
                border-radius: 50%;
            }
        }

        @@media only screen and (max-width: 600px) {
            .logo-nav {
                width: 135px;
                height: auto;
            }
        }

        .btn-nav {
            font-size: larger !important;
            color: white !important;
        }

        .custom-toggler {
