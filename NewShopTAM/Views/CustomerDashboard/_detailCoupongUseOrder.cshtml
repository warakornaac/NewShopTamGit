@using NewShopTAM.Models;
<style>
    .vcenter {
        text-align: center;
        vertical-align: middle !important;
    }

    .vright {
        text-align: right;
        vertical-align: middle !important;
    }
</style>
<div class="row">
    <div class="col-sm-12 col-md-12">
        <div class="table-responsive" style="margin-bottom: 0;">
            <table id="tablePromotionDetail" class="table table-bordered table-hover table-striped" style="margin-bottom: 0px;">
                <thead>
                    <tr style="background-color:lightseagreen;" class="text-light">
                        <th class="vcenter"> # </th>
                        <th class="vcenter"> ออเดอร์วันที่ </th>
                        <th class="vcenter"> ออเดอร์เลขที่ </th>
                        <th class="vcenter"> เบอร์สินค้า </th>
                        <th class="vcenter"> ชื่อสินค้า </th>
                        <th class="vcenter"> จำนวน </th>
                        <th class="vcenter"> ราคา/ชิ้น </th>
                        <th class="vcenter"> ราคารวม </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int rowList = 0;
                        double sumPackAmtAll = 0;
                        if (ViewBag.coupongUseOrderList != null && ViewBag.coupongUseOrderList.Count > 0)
                        {
                            foreach (var rowData in ViewBag.coupongUseOrderList)
                            {
                                rowList++;
                                <tr>
                                    <td class="vcenter sticky-col first-col" style="cursor: pointer;"> @rowList </td>
                                    <td class="vcenter"> @rowData.Orddate </td>
                                    <td class="vcenter"> @rowData.Docno </td>
                                    <td class="vcenter"> @rowData.Stkcode </td>
                                    <td class="vleft"> @rowData.Stkdesc </td>
                                    <td class="vcenter"> @rowData.Qty </td>
                                    <td class="vright"> @decimal.Parse(rowData.SalePrice).ToString("N0") </td>
                                    <td class="vright"> @decimal.Parse(rowData.TotalAmt).ToString("N0")</td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td class="vcenter" colspan="8"><i class="fa fa-exclamation-triangle" aria-hidden="true"></i> ไม่พบข้อมูล </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>