        function jssor_1_slider_init() {

            var jssor_1_options = {
                $AutoPlay: 0,
                $AutoPlaySteps: 5,
                $SlideDuration: 260,
                $SlideWidth: 200,
                $SlideSpacing: 3,
                $ArrowNavigatorOptions: {
