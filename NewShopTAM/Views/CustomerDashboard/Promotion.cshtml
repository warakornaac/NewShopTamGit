        function yearPromotion(year) {

            // $('#' + year + '').css("background", "#DEAF5B");
            var lastperoid = $('#periodpro').val();
            console.log("Peroid is " + lastperoid);
            if (lastperoid != "") {
                $('#btn-show-yearly').removeAttr('style');
                $('#btn-show-quarter').removeAttr('style');
                $('#btn-show-other').removeAttr('style');
                $('#btn-show-all').removeAttr('style');
                $('#yearpro').val(year);
                $('#detail-pro').show("slow");
                switch (lastperoid) {
                    case 'yearly':
                        $('#btn-show-yearly').css("background", "#DEAF5B");
                        $('.table-yearly').show('slow');
                        $('.table-quarter').hide('slow');
                        $('.table-other').hide('slow');
                        $('.table-all').hide('slow');
                        getPromotion('yearly');
                        break;
                    case 'quarter':
                        $('#btn-show-quarter').css("background", "#DEAF5B");
                        $('.table-quarter').show('slow');
                        $('.table-yearly').hide('slow');
                        $('.table-other').hide('slow');
                        $('.table-all').hide('slow');
                        getPromotion('quarter');
                        break;
                    case 'other':
                        $('#btn-show-other').css("background", "#DEAF5B");
                        $('.table-other').show('slow');
                        $('.table-yearly').hide('slow');
                        $('.table-quarter').hide('slow');
                        $('.table-all').hide('slow');
                        getPromotion('other');
                        break;
                    case 'all':
                        $('#btn-show-all').css("background", "#DEAF5B");
                        $('.table-all').show('slow');
                        $('.table-yearly').hide('slow');
                        $('.table-quarter').hide('slow');
                        $('.table-other').hide('slow');
                        getPromotion('all');
                        break;
                    default:
                        break;
                }
            }
            else {
                $('#btn-show-yearly').css("background", "#DEAF5B");
                $('#btn-show-quarter').removeAttr('style');
                $('#btn-show-other').removeAttr('style');
                $('#btn-show-all').removeAttr('style');
                $('.table-yearly').show('slow');
                $('.table-quarter').hide('slow');
                $('.table-other').hide('slow');
                $('.table-all').hide('slow');
                $('#yearpro').val(year);
                $('#detail-pro').show("slow");
                getPromotion('yearly');
            }

        }

        function getPromotion(period) {
            var cus = cuscod;
            var year = $('#yearpro').val();
            $.ajax({
                url: '@Url.Action("GetPromotionDetail", "CustomerDashboard")',
                data: {
                    CUSCOD: cus,
                    Period: period,
                    YEAR:year
                },
                type: 'POST',
                dataType: 'JSON',
                beforeSend: function () {
                    var SubmithtmlPag = '';
                    var yearly = $('#promotion-yearly-table tbody');
                    var quarter = $('#promotion-quarter-table tbody');
                    var other = $('#promotion-other-table tbody');
                    var all = $('#promotion-all-table tbody');
                    SubmithtmlPag += '<tr>';
                    SubmithtmlPag += '<td class="text-center" colspan="12"><i class="fa fa-circle-o-notch fa-spin" style="font-size:24px"></i>Loading...</td>';
                    SubmithtmlPag += '</tr>';

                    yearly.append(SubmithtmlPag);
                    quarter.append(SubmithtmlPag);
                    other.append(SubmithtmlPag);
                    all.append(SubmithtmlPag);
                },
                success: function (data) {
                    var SubmithtmlPag = '';
                    var reward_color = "";
                    if (data.message == 'Y') {
                        var yearly = $('#promotion-yearly-table tbody');
                        var quarter = $('#promotion-quarter-table tbody');
                        var other = $('#promotion-other-table tbody');
                        var all = $('#promotion-all-table tbody');

                        var _count = 0;
                        yearly.html("");
                        quarter.html("");
                        other.html("");
                        all.html("");
                        if (data.Getdata.length != 0) {
                            for (var i = 0; i < data.Getdata.length; i++) {
                                SubmithtmlPag += '<tr onclick="getDetailPromotion(' + '\'' + data.Getdata[i].Promotion_Code + '\'' + ')">';
                                SubmithtmlPag += '<td><i class="fa fa-search" aria-hidden="true"></i></td>';
                                SubmithtmlPag += '<td class="text-truncate"> <p class="cut-text m-0 p-0"><span>' + data.Getdata[i].Promotion_Name + '</span></p></td>';
                                SubmithtmlPag += '<td class="text-truncate" align="center"><span>' + formatDate(data.Getdata[i].StartDate)  + '</span></td>';
                                SubmithtmlPag += '<td class="text-truncate" align="center"><span>' + formatDate(data.Getdata[i].EndDate)  + '</span></td>';
                                SubmithtmlPag += '<td align="right"><span>' + commaSeparateNumber(data.Getdata[i].Condition) + '</span></td>';
                                SubmithtmlPag += '<td  align="right"><span>' + commaSeparateNumber(data.Getdata[i].Invoice_Amount) + '</span></td>';
                                SubmithtmlPag += '<td align="right"><span>' + commaSeparateNumber(data.Getdata[i].Remaining_Amount) + '</span></td>';
                                //SubmithtmlPag += '<td class="text-truncate">' + data.Getdata[i].Reward + '</td>';
                                if (data.Getdata[i].Reward.toString().toLowerCase().includes("ticket")) {
                                    reward_color = "bg-warning bg-opacity-75";
                                }
                                else if (data.Getdata[i].Reward.toString().includes("ตั๋ว")) {
                                    reward_color = "bg-warning bg-opacity-75 ";
                                }
                                else if (data.Getdata[i].Reward.toString().includes("เช็ค")) {
                                    reward_color = "bg-success bg-opacity-75";
                                }
                                else {
                                    reward_color = "bg-info bg-opacity-75 ";
                                }
                                SubmithtmlPag += '<td style="text-align: center;"> <span class="badge ' + reward_color + '">' + data.Getdata[i].Reward + '</span> </td>';
                                //SubmithtmlPag += '<td align="right"><span>' + commaSeparateNumber(Math.floor(data.Getdata[i].Reward_Amt)) + '</span></td>';
                                SubmithtmlPag += '<td class="text-truncate" align="center"><span>' + data.Getdata[i].Status + '</span></td>';
                                SubmithtmlPag += '<td class="text-truncate" align="center"><span>' + data.Getdata[i].Received_Date.replace(/\//g, '-')  + '</span></td>';
                                SubmithtmlPag += '<td class="text-truncate" align="center"><span>' + data.Getdata[i].Received_By + '</span></td>';
                                if (data.Getdata[i].WHT != 0) {
                                    SubmithtmlPag += '<td align="right"><span>' + commaSeparateNumber(data.Getdata[i].WHT) + '</span></td>';
                                }
                                else {
                                    SubmithtmlPag += '<td align="right"></td>';
                                }

                                SubmithtmlPag += '</tr>';
                                _count++;
                            }
                            if (period === 'yearly') {
                                console.log("test year");
                                yearly.append(SubmithtmlPag);
                                if ($.fn.dataTable.isDataTable('#promotion-yearly-table')) {
                                    $('#promotion-yearly-table').DataTable().destroy();
                                }
                                $('#promotion-yearly-table').DataTable({
                                    "paging": false,
                                    "lengthChange": false,
                                    "searching": false,
                                    "ordering": true,
                                    "info": false,
                                    "autoWidth": false,
                                    "responsive": false,
                                    "fixedHeader": false,
                                    "rowGroup": false,
                                    "columnDefs": [

                                    ]
                                });
                            } else if (period === 'quarter') {
                                quarter.append(SubmithtmlPag);
                                if ($.fn.dataTable.isDataTable('#promotion-quarter-table')) {
                                    $('#promotion-quarter-table').DataTable().destroy();
                                }
                                $('#promotion-quarter-table').DataTable({
                                    "paging": false,
                                    "lengthChange": false,
                                    "searching": false,
                                    "ordering": true,
                                    "info": false,
                                    "autoWidth": false,
                                    "responsive": false,
                                    "fixedHeader": false,
                                    "rowGroup": false,
                                    "columnDefs": [

                                    ]
                                });
                            } else if (period === 'other') {
                                other.append(SubmithtmlPag);
                                if ($.fn.dataTable.isDataTable('#promotion-other-table')) {
                                    $('#promotion-other-table').DataTable().destroy();
                                }
                                $('#promotion-other-table').DataTable({
                                    "paging": false,
                                    "lengthChange": false,
                                    "searching": false,
                                    "ordering": true,
                                    "info": false,
                                    "autoWidth": false,
                                    "responsive": false,
                                    "fixedHeader": false,
                                    "rowGroup": false,
                                    "columnDefs": [

                                    ]
                                });
                            } else if (period === 'all') {

                                all.append(SubmithtmlPag);
                                if ($.fn.dataTable.isDataTable('#promotion-all-table')) {
                                    $('#promotion-all-table').DataTable().destroy();
                                }
                                $('#promotion-all-table').DataTable({
                                    "paging": false,
                                    "lengthChange": false,
                                    "searching": false,
                                    "ordering": true,
                                    "info": false,
                                    "autoWidth": false,
                                    "responsive": false,
                                    "fixedHeader": false,
                                    "rowGroup": false,
                                    "columnDefs": [

                                    ]
                                });
                            }
                        }
                        else {
                            //// ถ้าไม่มีโปรโมชั่นเลย

                            SubmithtmlPag += '<tr>';
                            SubmithtmlPag += '<td class="text-center" colspan="12">-- ไม่พบข้อมูล --</td>'
                            SubmithtmlPag += '</tr>';
                            if (period === 'yearly') {
                                yearly.append(SubmithtmlPag);

                            } else if (period === 'quarter') {
                                quarter.append(SubmithtmlPag);
                            } else if (period === 'other') {
                                other.append(SubmithtmlPag);
                            } else if (period === 'all') {
                                all.append(SubmithtmlPag);
                            }
                        }
                    }
                    else {
                        console.log(data.message);
                    }
                }

            });
        }

        function getDetailPromotion(proCode) {
            $('#DetailModalCenter').modal('show');
            $.ajax({
                url: '@Url.Action("GetDetailPromotion", "CustomerDashboard")',
                data: {
                    CUSCOD: cuscod,
                    proCODE: proCode
                },
                type: 'POST',
                dataType: 'JSON',
                beforeSend: function () {
                    $('#tblpromotiondetail').DataTable().destroy();
                    var SubmithtmlPage = '';
                    var descript = "";
                    $('#prodes').text("");
                    $('#tblpromotiondetail tbody').html("");
                    SubmithtmlPage += '<tr>';
                    SubmithtmlPage += '<td class="text-center" colspan="8"><i class="fa fa-circle-o-notch fa-spin" style="font-size:24px"></i>Loading...</td>';
                    SubmithtmlPage += '</tr>';
                    $('#tblpromotiondetail tbody').append(SubmithtmlPage);

                },
                success: function (data) {
                    var SubmithtmlPage = '';
                    var descript = "";
                    var desPro = $('#prodes');
                    var table = $('#tblpromotiondetail tbody');
                    if (data.message == "Y") {
                        table.html("");
                        if (data.Getdata.length > 0) {
                            for (var i = 0; i < data.Getdata.length; i++) {
                                SubmithtmlPage += '<tr>';
                                SubmithtmlPage += '<td class="text-center"><span>' + data.Getdata[i].Company + '</span></td>';
                                SubmithtmlPage += '<td class="text-center"><p class="m-0 text-truncate"><span>' + data.Getdata[i].STKCOD + '</span></p></td>';
                                SubmithtmlPage += '<td><p class="cut-text m-0 p-0"><span>' + data.Getdata[i].STKDES + '</span></p></td>';
                                SubmithtmlPage += '<td><p class="m-0 text-truncate"><span>' + data.Getdata[i].DOCDAT.replace(/\//g, '-') + '</span></p></td>';
                                SubmithtmlPage += '<td class="text-center"><span>' + data.Getdata[i].DOCNUM + '</span></td>';
                                SubmithtmlPage += '<td class="text-right"><span>' + commaSeparateNumber(data.Getdata[i].SP_LCY) + '</span></td>';
                                SubmithtmlPage += '<td class="text-center"><span>' + commaSeparateNumber(data.Getdata[i].QTY) + '</span></td>';
                                SubmithtmlPage += '<td class="text-right"><span>' + commaSeparateNumber(data.Getdata[i].NET_LCY) + '</span></td>';
                                SubmithtmlPage += '</tr>';
                                descript = data.Getdata[i].Description;
                            }
                            desPro.text(descript);
                            table.append(SubmithtmlPage);
                            if ($.fn.dataTable.isDataTable('#tblpromotiondetail')) {
                                $('#tblpromotiondetail').DataTable().destroy();
                            }
                            $('#tblpromotiondetail').DataTable({
                                "paging": true,
                                "lengthChange": false,
                                "searching": false,
                                "ordering": true,
                                "info": false,
                                "autoWidth": false,
                                "responsive": false,
                                "fixedHeader": false,
                                "rowGroup": false,
                                "columnDefs": [

                                ]
                            });

                        }
                        else {
                            SubmithtmlPage += '<tr>';
                            SubmithtmlPage += '<td class="text-center" colspan="8">-- ไม่พบข้อมูล --</td>';
                            SubmithtmlPage += '</tr>';
                            table.append(SubmithtmlPage);
                        }
                    }
                    else {
                        console.log("Error : " + data.message);
                    }
                }

            })
        }

