        function getYearpromotion() {
            var cus = cuscod.trim();
            $.ajax({
                url: '@Url.Action("GetYearPromotion", "CustomerDashboard")',
                data: {
                    CUSCOD: cus
                },
                dataType: 'JSON',
                type: 'POST',
                beforeSend: function () {
                    $('#table-promotion-year tbody').html("");
                    var SubmithtmlPag = '';
                    SubmithtmlPag += '<tr>';
                    SubmithtmlPag += '<td align="center" colspan="7"><i class="fa fa-circle-o-notch fa-spin" style="font-size:24px"></i>Loading...</td>';
                    SubmithtmlPag += '</tr>';
                    $('#table-promotion-year tbody').append(SubmithtmlPag);
                },
                success: function (data) {
                    if (data.message == 'Y') {
                        var SubmithtmlPag = '';
