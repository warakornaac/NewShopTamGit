                min-height: 50px;
                position: relative;
                font-size: 30px;
                line-height: 50px;
                text-align: center;
                font-weight: 700;
                /* padding: 20px 15px 0; */
                color: #f1c40f;
            }

                .dl .discount:after {
                    content: " ";
                    border-right: 20px solid transparent;
                    border-left: 20px solid transparent;
                    position: absolute;
                    bottom: -20px;
                    left: 20%
                }

                .dl .discount.alizarin:after {
                    border-top: 20px solid #e74c3c
                }

