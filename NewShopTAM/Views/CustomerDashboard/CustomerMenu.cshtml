        }

            .dl:before {
                content: " ";
                height: 20px;
                width: 20px;
                background: #ddd;
                border-radius: 20px;
                position: absolute;
                left: 50%;
                top: 20px;
                margin-left: -10px
            }

            .dl .brand {
                text-transform: uppercase;
