@{
    var startYear = DateTime.Now.Year - 2;
    var endYear = DateTime.Now.Year;
}
<style>
    .textCut {
        display: inline-block;
        width: 200px;
        white-space: nowrap;
        overflow: hidden !important;
        text-overflow: ellipsis;
    }

    .vcenter {
        text-align: center;
        vertical-align: middle !important;
    }

    .vright {
        text-align: right;
        vertical-align: middle !important;
    }

    .table-style thead tr th {
        position: sticky;
        top: 0;
        left: 0;
        z-index: 2 !important;
    }

    .table-scroll thead tr:nth-child(2) th {
        top: 30px;
    }

    #table-history td:first-child {
        position: sticky;
        left: 0;
        background-color: #f2f2f2;
        max-width: 95px !important;
        white-space: nowrap;
        overflow: hidden !important;
        text-overflow: ellipsis;
    }

    .table-striped > tbody > tr:nth-of-type(odd) .sticky-col {
        background-color: #f9f9f9;
    }

    .table-striped > tbody > tr:nth-of-type(even) .sticky-col {
        background-color: #fff;
    }

    table > thead > tr > th .stkcod {
        padding: 8px;
        line-height: 1.42857143;
        vertical-align: top;
        border-top: 1px solid #ddd;
        max-width: 100px !important;
    }


    @@media only screen and (max-width: 576px) {
        #table-history td:first-child {
            position: sticky;
            left: 0;
            background-color: #f2f2f2;
            min-width: 90px !important;
            white-space: nowrap;
            overflow: hidden !important;
            text-overflow: ellipsis;
            padding-left: 20px;
        }
    }
</style>
<div class="m-0 table-style table-responsive table-scroll" style="height: 500px; overflow-y: auto;">
    <table class="table table-striped table-bordered table-hover mb-0 " id="table-history" style="padding: 7px;font-size: small;">
        <thead class="thead-default" style="font-size: small;">
            <tr>
                <th rowspan="2" class="vcenter stkcod" style="z-index: 5 !important;"><span>เบอร์สินค้า</span></th>
                <th rowspan="2" class="vcenter"><span>ชื่อสินค้า</span></th>
                @for (int i = endYear; i >= startYear; i--)
                {
                    <th colspan="2" class="vcenter"> @i </th>
                }
                <th rowspan="2" class="vcenter"> แบรนด์ </th>
                <th rowspan="2" class="vcenter"><span>บริษัท</span></th>
            </tr>
            <tr>
                @for (int i = 1; i <= 3; i++)
                {
                    <th class="vcenter"> จำนวน </th>
                    <th class="vcenter"> ราคารวม </th>
                }
            </tr>
        </thead>
        <tbody>
            @{
                if (ViewBag.Getdata.Count == 0)
                {
                    <tr>
                        <td colspan="10" style="text-align:center;"> -- ไม่พบข้อมูล -- </td>
                    </tr>
                }
                else
                {
                    int rowShop = 1;
                    foreach (var rowData in ViewBag.Getdata)
                    {
                        <tr>
                            <td class="sticky-col first-col">@rowData.Stkcod</td>
                            <td> <span class="textCut"> @rowData.Stkdes </span> </td>
                            @for (int i = 1; i <= 3; i++)
                            {
                                string valQty = "-";
                                string valAmt = "-";

                                switch (i)
                                {
                                    case 1:
                                        valQty = string.Format("{0:n0}", Convert.ToDouble(rowData.year_1_qty));
                                        valAmt = string.Format("{0:n0}", Convert.ToDouble(rowData.year_1_amt));
                                        break;
                                    case 2:
                                        valQty = string.Format("{0:n0}", Convert.ToDouble(rowData.year_2_qty));
                                        valAmt = string.Format("{0:n0}", Convert.ToDouble(rowData.year_2_amt));
                                        break;
                                    case 3:
                                        valQty = string.Format("{0:n0}", Convert.ToDouble(rowData.year_3_qty));
                                        valAmt = string.Format("{0:n0}", Convert.ToDouble(rowData.year_3_amt));
                                        break;
                                    default:
                                        valQty = "";
                                        valAmt = "";
                                        break;
                                }
                                <td class="vright">
                                    @if (@valQty == "0")
                                    {
                                        <span>-</span> }
                                    else
                                    {
                                        <span>@valQty</span>
                                    }
                                </td>
                                <td class="vright">
                                    @if (@valAmt == "0")
                                    {
                                        <span>-</span> }
                                    else
                                    {
                                        <span>@valAmt</span>
                                    }
                                </td>
                            }
                            <td class="vcenter">
                                @if (@rowData.Brand == "")
                                {
                                    <span>-</span> }
                                else
                                {
                                    <span>@rowData.Brand</span>
                                }
                            </td>
                            <td style="text-align:center;">@rowData.Company</td>
                        </tr>
                        rowShop++;
                    }
                }
            }
        </tbody>
    </table>
</div>
