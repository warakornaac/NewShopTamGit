    <style>
        .table-style {
            height: 500px;
            overflow-y: auto;
        }

        /*.table-style thead th {
                position: sticky;
                top: 0;
                background-color: white;
                z-index: 3 !important;
            }*/

        .sticky-head {
            position: sticky !important;
            top: 0;
            background-color: white;
            z-index: 3 !important;
        }

        .sticky-head-first {
            position: sticky !important;
            top: 0;
            left: 0;
            background-color: white;
            z-index: 5 !important;
        }

            .sticky-head-first:after {
                content: "";
                width: 1px;
                background: #ddd;
                position: absolute;
                top: 0;
                bottom: 0;
                right: -1px;
            }

        .sticky-col {
            position: -webkit-sticky; /* For Safari */
            position: sticky;
            left: 0;
            background-color: inherit; /* Background color for sticky elements */
            z-index: 4 !important; /* Ensure it is above other cells */
        }

            .sticky-col:after {
                content: "";
                width: 1px;
                background: #ddd;
                position: absolute;
                top: 0;
                bottom: 0;
                right: -1px;
            }

        .table-striped > tbody > tr:nth-of-type(odd) .sticky-col {
            background-color: #f9f9f9; /* Adjust based on your stripe color */
        }

        .table-striped > tbody > tr:nth-of-type(even) .sticky-col {
            background-color: #fff; /* Adjust based on your stripe color */
        }

