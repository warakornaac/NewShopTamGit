                type: "POST",
                dataType: "JSON",
                success: function (res) {
                    if (res.message == "Y") {
                        var alert_accept = 0;
                        var alert_packing = 0;
                        var alert_delivery = 0;
                        var alert_arrive = 0;
                        if (res.Getdata.length > 0) {
                            alert_accept = res.Getdata[0].Order;
                            alert_packing = res.Getdata[0].Pack;
                            alert_delivery = res.Getdata[0].Deliver;
                            alert_arrive = res.Getdata[0].Arrive;

                            if (alert_accept > 0) {
                                if (alert_accept > 99) {
                                    $('#status-accept').text('99+');
                                }
                                else {
                                    $('#status-accept').text(alert_accept);
