        function nl1br(el) {
            var str = el;
            var res = str.split("/");
            var x = res[1].length / 2;
            var html = res[0] + "<br>" + res[1].substring(0, 27) + "<br>" + res[1].substring(27, x + x);
            return html;
        }
        function nl3br(el) {
            var len = el.length;
            var x = len / 3;
            if (len > 15) {
                var html = el.substring(0, x) + "<br>" + el.substring(x, x + x) + "<br>" + el.substring(x + x, x + x + x);
            } else {
                var html = el;
            }
            return html;
        }
        function commaSeparateNumber(val) {
            while (/(\d+)(\d{3})/.test(val.toString())) {
                val = val.toString().replace(/(\d+)(\d{3})/, '$1' + ',' + '$2');
            }
            return val;
        }

        function getDatePreDate() {
            const result = [];
            const date = new Date();
            for (let i = 0; i < 7; i++) {
                const pastDate = new Date(date);
                pastDate.setDate(date.getDate() - i);

                var day = String(pastDate.getDate()).padStart(2, '0');
                var month = String(pastDate.getMonth() + 1).padStart(2, '0');
                var year = pastDate.getFullYear();
                var formattedDateDisplay = `${day}-${month}-${year}`;
                var formattedDateVal = `${year}/${month}/${day}`;
                result.push({ display: formattedDateDisplay, value: formattedDateVal })
            }
            return result;
        }

