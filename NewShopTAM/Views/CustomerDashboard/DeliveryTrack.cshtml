                                    SubmithtmlPage += '<td class="text-center text-truncate"><span>' + formattedDate + '</span></td>';
                                    SubmithtmlPage += '<td style="text-align:center">' + amt_order  + '</td>';

                                    SubmithtmlPage += '<td style="text-align:center"><span>' + commaSeparateNumber(amt_order) + ' / ' + commaSeparateNumber(data.Getdata[i].BCK_Qty) + '</span></td>';
                                    SubmithtmlPage += '<td class="text-center"><span>' + data.Getdata[i].ShipTo + '</span></td>';
                                    SubmithtmlPage += '<td class="text-center"><span>' + data.Getdata[i].Round + '</span></td>';
                                    if (data.Getdata[i].StartDelivery != "") {
                                        var dateST = data.Getdata[i].StartDelivery;
                                        var partsST = dateST.split(" ");
                                        var datePartST = partsST[0];
                                        var timePartST = partsST[1];

                                        var datePartsST = datePartST.split("-");
                                        var formattedDateST = datePartsST[2] + "-" + datePartsST[1] + "-" + datePartsST[0];
                                        SubmithtmlPage += '<td class="text-center text-truncate"><span>' + formattedDateST + ' ' + timePartST + '</span></td>';
                                    }
                                    else {
                                        SubmithtmlPage += '<td><span></span></td>';

                                    }
                                if (data.Getdata[i].ExpToArrive != "") {
                                    var dateEx = data.Getdata[i].ExpToArrive;
                                    var partsEx = dateEx.split(" ");
                                    var datePartEx = partsEx[0];
                                    var timePartEx = partsEx[1];

                                    var datePartsEx = datePartEx.split("-");
                                    var formattedDateEx = datePartsEx[2] + "-" + datePartsEx[1] + "-" + datePartsEx[0];
                                    SubmithtmlPage += '<td class="text-center text-truncate"><span>' + formattedDateEx + ' ' + timePartEx+ '</span></td>';
                                }
                                else {
                                    SubmithtmlPage += '<td><span></span></td>';

                                }
                                    SubmithtmlPage += '<td class="text-center"><span>' + data.Getdata[i].ORD_DocNo + '</span></td>';
                                    SubmithtmlPage += '</tr>';
                                }

                            }
                            $('#deliverytrack-delivery tbody').append(SubmithtmlPage);
                            if ($.fn.dataTable.isDataTable('#deliverytrack-delivery')) {
                                $('#deliverytrack-delivery').DataTable().destroy();
                            }
                            $('#deliverytrack-delivery').DataTable({
                                "paging": false,
                                "lengthChange": false,
                                "searching": false,
                                "ordering": true,
                                "info": false,
                                "autoWidth": false,
                                "responsive": false,
                                "fixedHeader": false,
                                "rowGroup": false,
                                "columnDefs": [
                                    { 'searchable': false, 'visible': false, 'targets': [3] },
                                    { 'orderData': [3], 'targets': [4] }
                                ]
                            });
                        }
                        else {
                            SubmithtmlPage += '<tr>';
                            SubmithtmlPage += '<td class="text-center" colspan="9">-- ไม่พบข้อมูล --</td>';
                            SubmithtmlPage += '</tr>';
                            $('#deliverytrack-delivery tbody').append(SubmithtmlPage);
                            $('#deliverytrack-delivery thead th:nth-child(4)').attr('hidden', true);

                        }
                    }
                    else {
                        console.log(data.message);
                    }
                }
            });
        }

