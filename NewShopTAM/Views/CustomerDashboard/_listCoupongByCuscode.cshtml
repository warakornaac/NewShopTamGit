                        </ul>
                    </div>*@
            </div>
        </div>
    </div>
    <div class="card-body pb-0 p-2" style="margin-bottom: -2px;">
     
        <div id="listCouponByStatus"> </div>

    </div>
</div>
<script defer>
    //default ดึงคูปองทั้งหมด
    $(document).ready(function () {
        getListCouponByStatus('all')
    });
    function getListCouponByStatus(statusCoupon, btn) {

        $('.btn-coupon').removeClass('active');

        if (btn) {
            $(btn).addClass('active');
        } else {
            $('.btn-coupon')
                .filter(function () {
                    return $(this).attr('onclick')
                        .includes("'" + statusCoupon + "'");
                })
                .addClass('active');
        }

        $.ajax({
            type: 'post',
            url: '@Url.Action("GetListCoupongByCuscodeStatus", "CustomerDashboard")',
            data: {
                cusCode: cuscod,
                status: statusCoupon
            },
            dataType: 'html',
            cache: false,
            async: true,
            beforeSend: function () {
                $('#listCouponByStatus').empty();
                $('#listCouponByStatus').html('<div style="padding-bottom: 10px; font-size: 14px;"> <i class="fa fa-spinner fa-spin fa-2x" aria-hidden="true"></i> กำลังโหลดข้อมูล... </div>');
            },
            success: function (res) {
                $('#listCouponByStatus').html(res);
            },
            error: function (er) {
                alert(er.error);
            }
        }).fail(function (error) {
            Swal.fire({
                icon: 'error',
                title: error.status,
                html: 'กรุณาแจ้งผู้ดูแลระบบ<br>โดยการแคปหน้าจอและก๊อปปี้ Error ด่านล่างนี้<br>getListCouponByStatus<br><br>',
                confirmButtonColor: '#d33',
                confirmButtonText: 'ปิด',
                allowOutsideClick: false,
                focusConfirm: false,
            });
        });
    }
</script>