<div class="card custom-card mb-2">
    <div class="card-header bg-primary pb-0 p-2">
        <div class="row">
            <div class="col-sm-4 text-left">
                <h3 class="card-title">คูปองส่วนลด</h3>
            </div>
            <div class="col-sm-8 text-right">
                <button type="button" class="btn btn-info btn-sm btn-coupon" onclick="getListCouponByStatus('all', this);" style="margin-bottom: 5px; font-size: 13px;"> ทั้งหมด </button>
                <button type="button" class="btn btn-info btn-sm btn-coupon" onclick="getListCouponByStatus('collect', this);" style="margin-bottom: 5px; font-size: 13px;"> เก็บแล้ว </button>
                <button type="button" class="btn btn-info btn-sm btn-coupon" onclick="getListCouponByStatus('use', this);" style="margin-bottom: 5px; font-size: 13px;"> ใช้งานแล้ว </button>
                @*<button type="button" class="btn btn-info btn-sm btn-coupon" onclick="getListCouponByStatus('pending', this);" style="margin-bottom: 5px; font-size: 13px;"> ยังไม่ถึงเวลาเก็บ </button>*@
