        window.onload = function () {
            var script = document.createElement("script");
            script.type = "text/javascript";
            script.src = "https://api.ipify.org?format=jsonp&callback=DisplayIP";
            document.getElementsByTagName("head")[0].appendChild(script);
        };

        function jssor_1_slider_init() {
            var jssor_1_options = {
                $AutoPlay: 0,
                $AutoPlaySteps: 5,
                $SlideDuration: 260,
                $SlideWidth: 200,
                $SlideSpacing: 3,
                $ArrowNavigatorOptions: {
                    $Class: $JssorArrowNavigator$,
                    $Steps: 1
                },
                $BulletNavigatorOptions: {
                    $Class: $JssorBulletNavigator$,
                    $SpacingX: 16,
                    $SpacingY: 16
                }
            };

            var jssor_1_slider = new $JssorSlider$("jssor_1", jssor_1_options);
            /*#region responsive code begin*/
            var MAX_WIDTH = 758;
            function ScaleSlider() {
                var containerElement = jssor_1_slider.$Elmt.parentNode;
                var containerWidth = containerElement.clientWidth;
                if (containerWidth) {
                    var expectedWidth = Math.min(MAX_WIDTH || containerWidth, containerWidth);
                    jssor_1_slider.$ScaleWidth(expectedWidth);
                }
                else {
                    window.setTimeout(ScaleSlider, 30);
                }
            }

            ScaleSlider();
            $Jssor$.$AddEvent(window, "load", ScaleSlider);
            $Jssor$.$AddEvent(window, "resize", ScaleSlider);
            $Jssor$.$AddEvent(window, "orientationchange", ScaleSlider);
        };

        function commaSeparateNumber(val) {
            while (/(\d+)(\d{3})/.test(val.toString())) {
                val = val.toString().replace(/(\d+)(\d{3})/, '$1' + ',' + '$2');
            }
            return val;
        }

        function getbackord(cusnc) {
                $.ajax({
                    url: '@Url.Action("getbackorder_notify", "CustomerDashboard")',
                    data: {
                        CUSCOD: cusnc
                    },
                    type: "POST",
                    dataType: "JSON",
                    success: function (data) {
                        $('#backordtb tbody:last-child').html("");
                        var aac_count = 0;
                        var tac_count = 0;
                        var omp_count = 0;

                        var aac = $('#backorder-aac-detail tbody');
                        var tac = $('#backorder-tac-detail tbody');
                        var omp = $('#backorder-omp-detail tbody');

                        var SubmithtmlPage_A = "";
                        var SubmithtmlPage_T = "";
                        var SubmithtmlPage_O = "";

                            aac.html("");


                            tac.html("");


                            omp.html("");

                        if (data.message == "Y") {
                            if (data.backorder.length > 0) {
                                for (var i = 0; i < data.backorder.length; i++) {
                                    if (data.backorder[i].Company == 'AAC') {
                                        SubmithtmlPage_A += '<tr>';
                                        SubmithtmlPage_A += '<td><p class="cut-text m-0 p-0">' + data.backorder[i].STKCOD + ' / ' + data.backorder[i].STKDES + '</p></td>';
                                        SubmithtmlPage_A += '<td class="orgbck" style="text-align:center"><p class="m-0 p-0">' + data.backorder[i].Qty + '</p></td>';
                                        SubmithtmlPage_A += '<td><p class="m-0 p-0">' + data.backorder[i].SaleOrderDate + '</p></td>';
                                        SubmithtmlPage_A += '<td><p class="m-0 p-0">' + data.backorder[i].DeliveryDate + '</p></td>';
                                        SubmithtmlPage_A += '</tr >';
                                        aac_count++;
                                    }
                                    if (data.backorder[i].Company == 'TAC') {
                                        SubmithtmlPage_T += '<tr>';
                                        SubmithtmlPage_T += '<td><p class="cut-text m-0 p-0">' + data.backorder[i].STKCOD + ' / ' + data.backorder[i].STKDES + '</p></td>';
                                        SubmithtmlPage_T += '<td class="orgbck" style="text-align:center"><p class="m-0 p-0">' + data.backorder[i].Qty + '</p></td>';
                                        SubmithtmlPage_T += '<td><p class="m-0 p-0">' + data.backorder[i].SaleOrderDate + '</p></td>';
                                        SubmithtmlPage_T += '<td><p class="m-0 p-0">' + data.backorder[i].DeliveryDate + '</p></td>';
                                        SubmithtmlPage_T += '</tr >';
                                        tac_count++;
                                    }
                                    if (data.backorder[i].Company == 'OMP') {
                                        SubmithtmlPage_O += '<tr>';
                                        SubmithtmlPage_O += '<td><p class="cut-text m-0 p-0">' + data.backorder[i].STKCOD + ' / ' + data.backorder[i].STKDES + '</p></td>';
                                        SubmithtmlPage_O += '<td class="orgbck" style="text-align:center"><p class="m-0 p-0">' + data.backorder[i].Qty + '</p></td>';
                                        SubmithtmlPage_O += '<td><p class="m-0 p-0">' + data.backorder[i].SaleOrderDate + '</p></td>';
                                        SubmithtmlPage_O += '<td><p class="m-0 p-0">' + data.backorder[i].DeliveryDate + '</p></td>';
                                        SubmithtmlPage_O += '</tr >';
                                        omp_count++;
                                    }

                                }
                                //$("#backordtb").append(SubmithtmlPage);
                                aac.append(SubmithtmlPage_A);
                                tac.append(SubmithtmlPage_T);
                                omp.append(SubmithtmlPage_O);

                            } else if (data.length <= 0) {
                                SubmithtmlPage_A += '<tr><td class="text-center" colspan="6">-- ไม่พบข้อมูล --</td></tr>';
                                SubmithtmlPage_T += '<tr><td class="text-center" colspan="6">-- ไม่พบข้อมูล --</td></tr>';
                                SubmithtmlPage_O += '<tr><td class="text-center" colspan="6">-- ไม่พบข้อมูล --</td></tr>';
                                aac.append(SubmithtmlPage_A);
                                tac.append(SubmithtmlPage_T);
                                omp.append(SubmithtmlPage_O);
                            }

                        }
                        else {
                            console.log(data.message);
                        }
                    }
                });
        }
        //ปุ่มยอดซื้อ
        $(document).on("click", "#navbaramount", function () {
            window.location.replace("../CustomerDashboard/index");
        });
        //ปุ่มสินค้าค้างส่ง
        $(document).on("click", "#navbarpending", function () {
            window.location.replace("../CustomerDashboard/PendingDeliver");
        });
        //ปุ่มสถานะการสั่งซื้อ
        $(document).on("click", "#navbardeliverytrack", function () {
            window.location.replace("../CustomerDashboard/DeliveryTrack");
        });
        //ปุ่มรายการเคลม
        $(document).on("click", "#navbarwarranty", function () {
            window.location.replace("../CustomerDashboard/Warranty");
        });
        //ปุ่มโปรโมชัน
        $(document).on("click", "#navbarpromotion", function () {
            window.location.replace("../CustomerDashboard/Promotion");
        });

        $('#changepass').click(function () {
            if (usertype == "6") {
                window.location.replace("../ChangePassword/Index");
            }
        });
