@{
    ViewBag.Title = "_DeliveryDetailByDocno";
    var typeDocno = @ViewBag.Docno.Substring(0, 1);

}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>รายละเอียด @ViewBag.Docno</title>
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.css" rel="stylesheet" />
    <link href="~/dashboard/assets/vendors/iconly/broken.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/dashboard/assets/vendors/perfect-scrollbar/perfect-scrollbar.css">
    <link rel="stylesheet" href="~/dashboard/assets/vendors/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="~/dashboard/assets/css/app.css">
    <link rel="shortcut icon" href="~/dashboard/assets/images/favicon.svg" type="image/x-icon">
    <link href="~/Content/Normalize.css" rel="stylesheet" />
    <script src="~/Scripts/webAddress.js"></script>
    <script src="~/Scripts/carousel-slider/js/jssor.slider-28.1.0.min.js"></script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@3.3.7/dist/css/bootstrap.min.css" integrity="sha384-BVYiiSIFeK1dGmJRAkycuHAHRg32OmUcww7on3RYdg4Va+PmSTsz/K68vbdEjh4u" crossorigin="anonymous">
    <style>
        @@import url("https://fonts.googleapis.com/css2?family=Kanit:ital,wght@0,400;0,500;0,600;1,500&display=swap");

        html body {
            font-family: 'Kanit', sans-serif;
        }

        html body {
            font-size: calc(0.50em + 1vmin);
        }

        .textCut {
            display: inline-block;
            width: 180px;
            white-space: nowrap;
            overflow: hidden !important;
            text-overflow: ellipsis;
        }

        .vcenter {
            text-align: center;
            vertical-align: middle !important;
        }

        .vright {
            text-align: right;
            vertical-align: middle !important;
        }

        .badgeCustom {
            min-width: 22px;
            /*padding: 5px 2px;*/
        }
    </style>
</head>
<body>
    <div class="content-wrapper" style="padding: 0.5rem 0.5rem;">
        @if (ViewBag.Getdata.Count == 0)
        {
            <div class="alert alert-danger text-center" style="font-size: 16px; font-weight: bold;"><i class="fa fa-exclamation-triangle" aria-hidden="true"></i> ไม่พบรายการสินค้า </div>
        }
        else
        {
            <div class="panel panel-default">
                <div class="row">
                    <div class="col-md-12">
                        <div class="panel-heading bg-default">
                            <i class="fa fa-list"></i> <b> หมายเลขคำสั่งซื้อ : @ViewBag.Docno </b>
                        </div>
                        <div class="panel-body" style="padding: 0px;">
                            <div class="table-responsive" style="margin-bottom: 0;">
                                <table class="table table-bordered table-hover table-striped" style="margin-bottom: 0px;">
                                    <thead class="thead-default" style="font-size: 10px;">
                                        <tr>
                                            <th class="vcenter" style="width: 4%;">#</th>
                                            @if (typeDocno == "T")
                                            {
                                                <th class="vcenter" style="width: 4%;">เลขที่ออเดอร์</th>
                                            }
                                            <th class="vcenter" style="width: 5%;">เบอร์สินค้า</th>
                                            <th class="vcenter" style="width: 40%;">ชื่อสินค้า</th>
                                            <th class="vcenter" style="width: 3%; white-space: nowrap;">ส่งได้ / ค้างส่ง</th>
                                            <th class="vcenter" style="width: 3%;">รวม</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int rowShop = 1;
                                            foreach (var rowData in ViewBag.Getdata)
                                            {
                                                int readyOrder = 0;
                                                if (Convert.ToInt32(rowData.BckQty) > 0)
                                                {
                                                    if (Convert.ToInt32(rowData.BckQty) < Convert.ToInt32(rowData.AmtQty))
                                                    {
                                                        readyOrder = Convert.ToInt32(rowData.BckQty) - Convert.ToInt32(rowData.AmtQty);
                                                    }
                                                }
                                                else
                                                {
                                                    readyOrder = Convert.ToInt32(rowData.AmtQty);
                                                }
                                                <tr>
                                                    <td class="vcenter">@rowShop</td>
                                                    @if (typeDocno == "T")
                                                    {
                                                        <td class="vcenter">@rowData.ORD_DocNo </td>
                                                    }
                                                    <td>@rowData.VSTKCOD </td>
                                                    <td><span class="textCut">@rowData.VSTKDES</span></td>
                                                    <td class="vcenter">
                                                        <div class="badge bg-success badgeCustom"> @readyOrder </div>
                                                        <span style="font-weight: 600;">/</span>
                                                        <div class="badge bg-info badgeCustom"> @rowData.BckQty </div>
                                                    </td>
                                                    <td class="vcenter">
                                                        <div class="badge bg-primary badgeCustom"> @rowData.AmtQty </div>
                                                    </td>
                                                </tr>
                                                rowShop++;
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</body>
</html>
