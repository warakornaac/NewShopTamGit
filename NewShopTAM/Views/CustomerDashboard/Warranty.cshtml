        //Return TAB
        function GetReturnCount(cus) {
            $.ajax({
                url: '@Url.Action("GetReturnCount", "CustomerDashboard")',
                data: {
                    CUSCOD: cus
                },
                type: "POST",
                dataType: "JSON",
                success: function (data) {
                    if (data.length > 0) {
                        var total = 0;
                        for (var i = 0; i < data.length; i++) {
                            console.log("has data :" + data[i].C);
                            var waiting = data[i].A != "" ? data[i].A : "0";
                            var approve = data[i].B != "" ? data[i].B : "0";
                            var refuse = data[i].C != "" ? data[i].C : "0";
                            if (waiting == 0) {
                                $('#status-wait-return').hide();
                            }
                            else {
                                if (Number(waiting) > 99) {
                                    $('#status-wait-return').text('99+')
                                }
                                else {
                                    $('#status-wait-return').text(waiting)
                                }
                            }

                            if (approve == 0) {
                                $('#status-approve-return').hide();
                            }
                            else {
                                if (Number(approve) > 99) {
                                    $('#status-approve-return').text('99+')
                                }
                                else {
                                    $('#status-approve-return').text(approve)
                                }
                            }

                            if (refuse == 0) {
                                $('#status-refuse-return').hide();
                            }
                            else {
                                if (Number(refuse) > 99) {
                                    $('#status-refuse-return').text('99+')
                                }
                                else {
                                    $('#status-refuse-return').text(refuse)
                                }
                            }
                            getReturnWaiting();

                        }

                    }
                }
            });
        }
