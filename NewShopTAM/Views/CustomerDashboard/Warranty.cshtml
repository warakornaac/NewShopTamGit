                type: "POST",
                dataType: "JSON",
                success: function (data) {
                    if (data.length > 0) {
                        var total = 0;
                        for (var i = 0; i < data.length; i++) {
                            console.log("has data :" + data[i].C);
                            var waiting = data[i].A != "" ? data[i].A : "0";
                            var inprogress = data[i].B != "" ? data[i].B : "0";
                            var approve = data[i].C != "" ? data[i].C : "0";
                            var refuse = data[i].D != "" ? data[i].D : "0";
                            //$('#status-wait').text(waiting);
                            //$('#status-inspect').text(inprogress);
                            //$('#status-approve').text(approve);
                            //$('#status-refuse').text(refuse);

                            console.log(waiting);
                            console.log(inprogress);
                            console.log(approve);
                            if (waiting == 0) {
                                $('#status-wait').hide();
                            }
                            else {
                                if (Number(waiting) > 99) {
                                    $('#status-wait').text('99+')
                                }
                                else {
                                    $('#status-wait').text(waiting)
                                }
                            }

                            if (inprogress == 0) {
                                $('#status-inspect').hide();
                            }
                            else {
                                if (Number(inprogress) > 99) {
                                    $('#status-inspect').text('99+')
                                }
                                else {
                                    $('#status-inspect').text(inprogress)
                                }
                            }

                            if (approve == 0) {
                                $('#status-approve').hide();
                            }
                            else {
                                if (Number(approve) > 99) {
                                    $('#status-approve').text('99+')
                                }
                                else {
                                    $('#status-approve').text(approve)
                                }
                            }

                            if (refuse == 0) {
