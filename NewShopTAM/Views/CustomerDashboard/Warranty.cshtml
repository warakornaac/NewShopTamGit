        function getCusName() {
            $.ajax({
                url: '@Url.Action("GetdatabyCus", "CustomerDashboard")',
                data: {
                    cusel: cuscod
                },
                type: 'POST',
                dataType: 'JSON',
                success: function (data) {
                    if (data.length != 0) {
                        var head = $('#head-cusname');
                        var name = data[0].CUSNAM;
                        var club = data[0].CLUB;
                        if (club != "") {
                            head.text(name + '(' + club + ')');
                        }
                        else {
                            head.text(name);
                        }
                    }
                }
            });
        }
        function commaSeparateNumber(val) {
            while (/(\d+)(\d{3})/.test(val.toString())) {
                val = val.toString().replace(/(\d+)(\d{3})/, '$1' + ',' + '$2');
            }
            return val;
        }

        function formatDate(dateString) {
            let sym = dateString.includes('/') ? '/' : '-';
            let dateParts = dateString.split(sym);
            let day = dateParts[0];
            let month = dateParts[1];
            let year = dateParts[2].slice(-2);
            return `${day}-${month}-${year}`;
        }
        function formatDateReverse(dateString) {
            let sym = dateString.includes('/') ? '/' : '-';
            let dateParts = dateString.split(sym);
            let day = dateParts[2];
            let month = dateParts[1];
            let year = dateParts[0].slice(-2);
            return `${day}-${month}-${year}`;
        }

        function toggleRowWaranty(row,col) {
            var text = $('#show-'+col+'-icon');
            if (text.text() === '+') {
                text.text("-");
            } else {
                text.text("+");
            }
            var targetId = row.getAttribute('data-bs-target');
            var targetElement = document.getElementById(targetId.substring(1));
            $(targetElement).collapse('toggle');
        }

        function getWarranty_Count(cus) {
            $.ajax({
