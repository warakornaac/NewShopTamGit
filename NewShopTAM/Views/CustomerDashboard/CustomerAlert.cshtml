<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TEST FUNCTION</title>
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    <link href="~/dashboard/assets/vendors/iconly/broken.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/dashboard/assets/vendors/perfect-scrollbar/perfect-scrollbar.css">
    <link rel="stylesheet" href="~/dashboard/assets/vendors/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="~/dashboard/assets/css/app.css">
    <link rel="shortcut icon" href="~/dashboard/assets/images/favicon.svg" type="image/x-icon">

    <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">

    <link href="~/Content/Normalize.css" rel="stylesheet" />
    <script src="~/Scripts/webAddress.js"></script>
    <script src="~/Scripts/carousel-slider/js/jssor.slider-28.1.0.min.js"></script>


    <!-- Import jQuery 2.1.1 and jQuery UI CSS -->
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">
    <!-- Import jQuery 2.1.1 -->
    <script src="https://code.jquery.com/jquery-2.1.1.min.js"></script>
    <!-- Import jQuery UI 1.11.4 -->
    <script src="https://code.jquery.com/ui/1.11.4/jquery-ui.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <main id="main">
        <button class="btn btn-success" id="ok-btn">Submit</button>
        <div class="container" id="first-div">
            <div class="container text-center">
                <h3>User Device</h3>
                <p>Operating System: @ViewBag.OS</p>
                <p>Browser: @ViewBag.Browser</p>
                <p>IP Address: @ViewBag.IP</p>
                <p>MAC Address: @ViewBag.Mac</p>
                <p><span id="location_text"></span></p>

            </div>
        </div>
        <div class="container text-center  d-flex justify-content-center" id="sec-div">
            <div class="card">
                <h4 class="card-header bg-warning">แจ้งเตือน!!!</h4>
                <div class="card-body p-3">
                    <img src="~/images/logo/AACTAC185x70.jpg" />

                    <p class="mt-2">ผู้ใช้งานไม่สามารถเข้าใช้งานได้</p>
                </div>
            </div>
        </div>
    </main>
    <script>
        var x = document.getElementById("location_text");
        function Alert() {
            Swal.fire({
                title: "Warning",
                text: "กรุณาเลือกลูกค้า",
                icon: "warning",
                backdrop: "false"
            });
        }
        $(document).on("click", "#ok-btn", function () {
            switchDiv();
        });
        function switchDiv() {
            $('#first-div').attr('hidden', true);
            $('#sec-div').removeAttr('hidden');
        }
        $(document).ready(function () {
            getLocation();
            //Alert();
        });

        function getLocation() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(showPosition);
            }
            else {
                x.innerHTML = "Geolocation is not supported by this browser.";
            }
        }
        function showPosition(position) {
            var text = '';
            text = 'Latitude: ' + position.coords.latitude + '<br>Longitude: ' + position.coords.longitude;
            x.innerHTML = "Latitude: " + position.coords.latitude + "<br>Longitude: " + position.coords.longitude;
            console.log(text);
        }
    </script>
</body>
</html>