                                        "lengthChange": false,
                                        "searching": false,
                                        "ordering": true,
                                        "info": false,
                                        "autoWidth": false,
                                        "responsive": false,
                                        "fixedHeader": false,
                                        "rowGroup": false,
                                        "columnDefs": [
                                            { 'orderable': false, 'targets': [0] }
                                        ]
                                    });
                                }
                                if (comp === 'TAC') {
                                    tac.append(SubmithtmlPage);
                                    if ($.fn.dataTable.isDataTable('#bill-tac-detail')) {
                                        $('#bill-tac-detail').DataTable().destroy();
                                    }
                                    $('#bill-tac-detail').DataTable({
                                        "paging": false,
                                        "lengthChange": false,
                                        "searching": false,
                                        "ordering": true,
                                        "info": false,
                                        "autoWidth": false,
                                        "responsive": false,
                                        "fixedHeader": false,
                                        "rowGroup": false,
                                        "columnDefs": [
                                            { 'orderable': false, 'targets': [0] }
                                        ]
                                    });
                                }
                                if (comp === 'OMP') {
                                    omp.append(SubmithtmlPage);
                                    if ($.fn.dataTable.isDataTable('#bill-omp-detail')) {
                                        $('#bill-omp-detail').DataTable().destroy();
                                    }
                                    $('#bill-omp-detail').DataTable({
                                        "paging": false,
                                        "lengthChange": false,
                                        "searching": false,
                                        "ordering": true,
                                        "info": false,
                                        "autoWidth": false,
                                        "responsive": false,
                                        "fixedHeader": false,
                                        "rowGroup": false,
                                        "columnDefs": [
                                            { 'orderable': false, 'targets': [0] }
                                        ]
                                    });
                                }
                            }
                            else {
                                var aac = $('#bill-aac-detail tbody');
                                var tac = $('#bill-tac-detail tbody');
                                var omp = $('#bill-omp-detail tbody');

                                if (comp === 'AAC') {
                                    aac.html("");
                                }
                                if (comp === 'TAC') {
                                    tac.html("");
                                }
                                if (comp === 'OMP') {
                                    omp.html("");
                                }
                                var SubmithtmlPage = '';
                                SubmithtmlPage += '<tr>';
                                SubmithtmlPage += '<td class="text-center" colspan="5">-- ไม่พบข้อมูล --</td>';
                                SubmithtmlPage += '</tr>';
                                //$('#bildue-table tbody').append(SubmithtmlPage);
                                if (comp === 'AAC') {
                                    aac.append(SubmithtmlPage);
                                }
                                if (comp === 'TAC') {
                                    tac.append(SubmithtmlPage);
                                }
                                if (comp === 'OMP') {
                                    omp.append(SubmithtmlPage);
                                }
                            }
                        }
                        else {
                            console.log(data.message);
                        }
                    }

                });
            }
            else {
                //console.log('Error!!!');
                var SubmithtmlPage = '';

                var aac = $('#bill-aac-detail tbody');
                var tac = $('#bill-tac-detail tbody');
                var omp = $('#bill-omp-detail tbody');
                if (comp === 'AAC') {
