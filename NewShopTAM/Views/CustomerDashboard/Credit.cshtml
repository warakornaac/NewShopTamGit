        function getLastSixMonths() {
            const result = [];
            const date = new Date();
            for (let i = 0; i < 6; i++) {
                const month = date.getMonth() + 1;
                const year = date.getFullYear();
                const formattedMonth = month; //< 10 ? `0${month}` : `${month}`; #01549b
                result.push({ display: `${year}-${formattedMonth}`, value: `${year}, ${formattedMonth}` });
                date.setMonth(date.getMonth() - 1);
            }
            return result;
        }

