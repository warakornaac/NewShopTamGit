        function toggleRowAndButton(row, index) {
            var text = $('#row-show-' + index);
            if (text.text() === '+') {
                text.text("-");
                //$('#')
            } else {
                text.text("+");
            }
            // เพิ่มการแสดง/ซ่อนข้อมูลเพิ่มเติม
            var targetId = row.getAttribute('data-bs-target');
            var targetElement = document.getElementById(targetId.substring(1));
            $(targetElement).collapse('toggle');
        }
        function toggleRowColDetail(row,index,comp) {
            var text = $('#show-sales-'+comp+'-icon-' + index);
            if (text.text() === '+') {
                text.text("-");
                //$('#')
            } else {
                text.text("+");
            }
            // เพิ่มการแสดง/ซ่อนข้อมูลเพิ่มเติม
            var targetId = row.getAttribute('data-bs-target');
            var targetElement = document.getElementById(targetId.substring(1));
            $(targetElement).collapse('toggle');
        }


