                        $('#omp-baldue').text(commaSeparateNumber(ompbaldue));

                        $('#aac-bildue-date').text(aacbildue);
                        $('#tac-bildue-date').text(tacbildue);
                        $('#omp-bildue-date').text(ompbildue);



                    }
