@{ ViewBag.Title = "Index Vehicle"; }

<head>
    <meta charset="utf-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">

    <link rel="stylesheet" href="~/dashboard/assets/vendors/bootstrap-icons/bootstrap-icons.css">

    <link href="~/bootstrap-select-1.13.14/dist/css/bootstrap-select.css" rel="stylesheet" />
    <script src="~/contentfilter/js/jquery-2.1.1.js"></script>
    <script src="~/contentfilter/js/jquery.mixitup.min.js"></script>
    <link href="~/Content/Normalize.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.10.8/sweetalert2.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.10.8/sweetalert2.min.css">

    <style>
    </style>

</head>
<h2>@*SearchPartnoCompany*@</h2>
@*show detail before send*@
<div class="container-fluid mt--90" style="padding-top: 5px; padding-bottom: 10px;">
    <div class="row">
        <div class="col-12">

            <div class="card">
                <div class="card-header bg-primary text-white font-weight-bold">
                    <div class="row">
                        <div class="col-xs-8 col-sm-8 col-md-8 text-left">
                            <i class="fa fa-cab"></i> Result Vehicle brand
                            @*<span id="txtHeadPromotionDetail"></span>*@
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row p-1">
                            @if (ViewBag.dataResponse.VehicleListData != null && (ViewBag.dataResponse.VehicleListData).Count > 0)
                            {
                                foreach (var rowDataV in ViewBag.dataResponse.VehicleListData)
                                {
                                <div class="col-3 col-md-2 col-xl-1" style="cursor: pointer;" onclick="getModelSeries(@rowDataV.manuId)">
                                    <span class="d-flex flex-column align-items-center justify-content-center bg-body-secondary rounded display-6 pt-3 pb-3" style="border: 1px solid #b3b3b3; margin-top: 2px;">
                                        <i class="fa fa-cab mb-1"> @rowDataV.manuId </i>
                                        <span style="font-size: 12px;white-space: nowrap;"> @rowDataV.manuName</span>
                                    </span>
                                </div> 
                                }       
                            } 
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="showResultModel" class="pt-1 pb-1"></div>
</div>

<script>
    function getModelSeries(txtBrand) {
        var setTxtBrand = null;
        if (txtBrand != null) {
            setTxtBrand= txtBrand;
        }
        var msg = '';
        var error = 0;
        if (txtBrand == "") {
            ++error;
            msg += '<br>' + error + '. กรุณากรอก Id Model';
        }

        if (error) {
            Swal.fire({
                icon: 'warning',
                title: 'กรุณาตรวจสอบข้อมูลต่อไปนี้',
                html: msg,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Close',
                allowOutsideClick: false,
                focusConfirm: false,
            });
            return false;
        } else {
            $.ajax({
                url: '@Url.Action("GetModelSeries", "Techdoc")',
                type: 'POST',
                data: {
                    BrandId: setTxtBrand
                },
                dataType: 'html',
                cache: false,
                Async: true,
                beforeSend: function () {
                    $('#showResultModel').empty();
                    $('#showResultModel').html('<div style="padding: 30px; font-size: 14px;"> <i class="fa fa-spinner fa-spin fa-2x" aria-hidden="true"></i> กำลังโหลดข้อมูล Data Model ... </div>');
                    //LoadingShow();
                },
                success: function (res) {
                    $('#showResultModel').html(res);
                    //$("#txtHeadPromotionDetail").text(promotionText);
                    //LoadingHide();
                }
            });
        }
    }

</script>
