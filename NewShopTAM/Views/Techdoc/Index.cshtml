@*@{ ViewBag.Title = "Index"; }*@

<head>
    <meta charset="utf-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">

    <link rel="stylesheet" href="~/dashboard/assets/vendors/bootstrap-icons/bootstrap-icons.css">

    <link href="~/bootstrap-select-1.13.14/dist/css/bootstrap-select.css" rel="stylesheet" />
    <script src="~/contentfilter/js/jquery-2.1.1.js"></script>
    <script src="~/contentfilter/js/jquery.mixitup.min.js"></script>
    <link href="~/Content/Normalize.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.10.8/sweetalert2.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.10.8/sweetalert2.min.css">

    <style>
    </style>

</head>
<h2>@*SearchPartnoCompany*@</h2>
@*show detail before send*@
<div class="container-fluid mt--90" style="padding-top: 5px; padding-bottom: 10px;">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white font-weight-bold" style="cursor: pointer;">
                    <div class="row">
                        <div class="col-sm-12"> <i class="fa fa-cab"></i> Get result by api tecAlliance  >>> <a href="~/Techdoc/GetVehicleAll" target="_blank" class="font-weight-bold text-white"> Api Vehicle </a> <<< </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row pl-2">
                        <div class="col-sm-8 col-md-8">
                            <div class="form-group">
                                <label class="control-label font-weight-bold" for=""> PartNumber  </label>  JTC7587 | 0242135553 | 1AFT120 | 589655 - ใบปัด | 1RPW011 - Rack | 328069710 -  Clutch Disc | SB.TT.D011 - Ring | DF1598 | PFB350 | 39070
                                <input type="text" class="form-control" style="text-align: left;" id="txtPartno" value="0242135553" />
                                <input type="text" class="form-control" style="text-align: left;" id="txtSupplierId" value="101" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="col-sm-12 text-right">
                        <button type="button" class="btn btn-md btn-success" onclick="getArticlesPartNumberNearby();"><i class="fa fa-cog"></i> Get PartNumber Alternative </button>
                        <button type="button" class="btn btn-md btn-success" onclick="getArticles();"><i class="fa fa-list"></i> Get Product data </button> &nbsp;
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="showResultPartNumberNearby" class="pt-1 pb-1"></div>
    <div id="showResultArticles" class="pt-1 pb-1"></div>
</div>

<script>
        function getArticles() {
            var txtPartno = $("#txtPartno").val();
            var txtSupplierId = $("#txtSupplierId").val();
            var msg = '';
            var error = 0;
            if (txtPartno == "") {
                ++error;
                msg += '<br>' + error + '. กรุณากรอก Partno';
            }

            if (error) {
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณาตรวจสอบข้อมูลต่อไปนี้',
                    html: msg,
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'Close',
                    allowOutsideClick: false,
                    focusConfirm: false,
                });
                return false;
            } else {
                $.ajax({
                    url: '@Url.Action("getArticles", "Techdoc")',
                    type: 'POST',
                    data: {
                        Partno: txtPartno.trim(),
                        DataSupplierId: txtSupplierId.trim()
                    },
                    dataType: 'html',
                    cache: false,
                    Async: true,
                    beforeSend: function () {
                        $('#showResultArticles').empty();
                        $('#showResultArticles').html('<div style="padding: 30px; font-size: 14px;"> <i class="fa fa-spinner fa-spin fa-2x" aria-hidden="true"></i> กำลังโหลดข้อมูล Product data ... </div>');
                        //LoadingShow();
                    },
                    success: function (res) {
                        $('#showResultArticles').html(res);
                        //$("#txtHeadPromotionDetail").text(promotionText);
                        //LoadingHide();
                    }
                });
            }
        }
        function getArticlesPartNumberNearby() {
            var txtPartno = $("#txtPartno").val();
            var msg = '';
            var error = 0;
            if (txtPartno == "") {
                ++error;
                msg += '<br>' + error + '. กรุณากรอก Partno';
            }

            if (error) {
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณาตรวจสอบข้อมูลต่อไปนี้',
                    html: msg,
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'Close',
                    allowOutsideClick: false,
                    focusConfirm: false,
                });
                return false;
            } else {
                $.ajax({
                    url: '@Url.Action("getArticlesPartNumberNearby", "Techdoc")',
                    type: 'POST',
                    data: {
                        Partno: txtPartno.trim()
                    },
                    dataType: 'html',
                    cache: false,
                    Async: true,
                    beforeSend: function () {
                        $('#showResultPartNumberNearby').empty();
                        $('#showResultPartNumberNearby').html('<div style="padding: 30px; font-size: 14px;"> <i class="fa fa-spinner fa-spin fa-2x" aria-hidden="true"></i> กำลังโหลดข้อมูล PartNumber Alternative ... </div>');
                        //LoadingShow();
                    },
                    success: function (res) {
                        $('#showResultPartNumberNearby').html(res);
                        //LoadingHide();
                    }
                });
            }
    }

</script>
