@{
    ViewBag.Title = "Change Password";
    string domainName = HttpContext.Current.Request.Url.GetLeftPart(UriPartial.Authority);
}
<html lang="en">
<head>
    <title>Change Password</title>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <link href="~/Content/styleLogin.css" rel="stylesheet" />
    <style>
        a, a:hover {
            color: #333
        }

        .warning-red {
            color: red;
        }

        .red-star {
            color: red;
        }

        .bg-login-color-redient {
            background: linear-gradient(0deg, rgba(255,255,255,1) 0%, rgba(0,123,255,1) 100%);
        }

        .disable-link {
            pointer-events: none;
            cursor: default;
            color: dimgray;
        }

        .otp {
            margin: 5px;
            text-align: center;
        }

        @@media only screen and (min-width: 412px) {
            .otp {
                height: 50px;
                width: 50px;
            }
        }

        @@media only screen and (min-width: 375px) {
            .otp {
                height: 50px;
                width: 40px;
            }
        }

        @@media only screen and (max-width: 374px) {
            .otp {
                height: 50px;
                width: 30px;
            }
        }

        .otp-form {
            display: flex;
            flex-flow: row wrap;
            align-items: center;
        }
        /**/
        @@import url("https://fonts.googleapis.com/css2?family=Kanit:ital,wght@0,400;0,500;0,600;1,500&display=swap");

        html body {
            font-family: 'Kanit', sans-serif;
        }

        .otp .otp-number {
            font-size: 0;
            margin-bottom: 15px;
        }

            .otp .otp-number .form-control + .form-control {
                margin-left: 6px;
            }

        .otp-number > .otp {
            margin-bottom: 0;
        }

        .otp .form-control {
            display: inline-block;
            width: calc(16.6666666% - 5px);
            border: none;
            font-size: 24px;
            text-align: center;
            font-weight: 400;
            background-color: #fff;
            padding-left: 0;
            padding-right: 0;
            height: 60px;
            -webkit-border-radius: 10px;
            -moz-border-radius: 10px;
            border-radius: 10px;
        }

        .otp p {
            text-align: center;
            opacity: .8;
            margin: 0;
        }
    </style>
</head>
<body class="bg-login-color-redient">
    <div class="wrapper">
        <div class="content-wrapper">
            <div class="form-bg d-flex ">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-md-6 text-center mb-5">
                        </div>
                    </div>
                    <div class="row justify-content-center">
                        <div class="col-md-7 col-lg-5">
                            <div class="wrap">
                                @*<div class="img" style="background-image: url(../../images/bg-1.jpg);"></div>*@
                                <div class="login-wrap p-4 p-md-5">
                                    <div class="d-flex text-center">
                                        <div class="w-100">
                                            <h4 class="font-weight-bold" style="color: #000000;">Change Password</h4>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label" for="oldpassword" style="color: #2d6eff; font-weight: bold; font-size: 13px; margin-bottom: 2px; ">Old Password</label>
                                        <div class="input-group mb-1" id="show_hide_password">
                                            <input type="password" class="form-control" id="inputoldPassword" name="oldpassword" placeholder="OldPassword" onkeypress="return (event.charCode >= 65 && event.charCode <= 90) || (event.charCode >= 97 && event.charCode <= 122) || (event.charCode >= 48 && event.charCode <= 57) " required>
                                            <div class="input-group-append ">
                                                <a href="" class="btn border d-flex align-items-center justify-content-center"><i class="fa fa-eye-slash" aria-hidden="true"></i></a>
                                            </div>
                                        </div>
                                        <p class="warning-red" id="wrong-oldpass" hidden>รหัสผ่านเก่าไม่ถูกต้อง</p>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label" for="username" style="color: #2d6eff; font-weight: bold; font-size: 13px; margin-bottom: 2px; ">New Password</label>
                                        <div class="input-group mb-1" id="show_hide_newpassword">
                                            <input type="password" class="form-control" id="inputnewPassword" name="newpassword" placeholder="NewPassword" onkeypress="return (event.charCode >= 65 && event.charCode <= 90) || (event.charCode >= 97 && event.charCode <= 122) || (event.charCode >= 48 && event.charCode <= 57)" required>
                                            <div class="input-group-append ">
                                                <a href="" class="btn border d-flex align-items-center justify-content-center"><i class="fa fa-eye-slash" aria-hidden="true"></i></a>
                                            </div>
                                        </div>
                                        <p class="warning-red" id="wrongpass" hidden>Password ไม่ถูกต้อง</p>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label" for="username" style="color: #2d6eff; font-weight: bold; font-size: 13px; margin-bottom: 2px; ">Confirm Password</label>
                                        <div class="input-group mb-1" id="show_hide_confirmpassword">
                                            <input type="password" class="form-control" id="inputConfirmPassword" name="confirmpassword" placeholder="ConfirmPassword" onkeypress="return (event.charCode >= 65 && event.charCode <= 90) || (event.charCode >= 97 && event.charCode <= 122) || (event.charCode >= 48 && event.charCode <= 57)" required>
                                            <div class="input-group-append ">
                                                <a href="" class="btn border d-flex align-items-center justify-content-center"><i class="fa fa-eye-slash" aria-hidden="true"></i></a>
                                            </div>
                                        </div>
                                        <p class="warning-red" id="passequal" hidden>New Password และ Confirm Password ไม่ตรงกัน</p>
                                    </div>
                                    <div class="form-group">
                                        <button type="submit" class="form-control btn btn-primary rounded submit px-3" onclick="changePassword();">Change Password</button>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @*OTP MODAL*@
    <!-- Modal -->
    <div class="modal fade modal-otp" id="exampleModalCenter" tabindex="-1" role="dialog" aria-labelledby="ModalCenterTitle" aria-hidden="true" data-backdrop="static">
        <input type="hidden" id="phone" />
        <input type="hidden" id="cuscod" />
        <input type="hidden" id="email" />
        <input type="hidden" id="lineid" />
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLongTitle">ยืนยันตัวตน</h5>
                    <button type="button" class="close" data-dismiss="modal-otp" aria-label="Close" onclick="$('#exampleModalCenter').modal('hide');">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body d-flex justify-content-center">
                    <div class="box box-success">
                        <div class="box-header with-border">
                        </div>
                        <div class="box-body">
                            <p class="text-07" style="line-height: 16pt;"> กรุณากรอกรหัส OTP ที่ได้รับทาง SMS ด้านล่างเพื่อยืนยันตัวตน หากไม่ได้รับรหัส OTP กรุณาตรวจสอบเบอร์โทรศัพท์มือถือด้านล่างให้ถูกต้องและกดปุ่ม “ขอรหัสOTP”</p>
                            <label class="control-label" style="color: #000000; font-weight: bold; font-size: 13px; margin-bottom: 2px;">เบอร์โทรศัพท์มือถือที่รับ OTP</label>
                            <div class="input-group mb-1">
                                <input type="text" class="form-control" id="otpphone" aria-describedby="basic-addon2" readonly>
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-outline-secondary btn-info text-white" id="sendotp_btn" onclick="delaySendOtp(); sendOtp();">ขอรหัส OTP</button>
                                </div>
                            </div>
                            @*<div class="small text-center mt-2 text-muted" id="counter-resend-text">กรุณารอ <span id="login-counter-resend">00</span> วินาทีเพื่อขอรหัส OTP ใหม่อีกครั้ง</div>*@
                            <div class="mb-1 rounded-4 text-center divShopOtp" style="background-color: #dce4eb; border-radius: 3px; display: none;">
                                <p class="m-0" id="refid"><span id="refhead">Ref : </span><span id="ref_show"></span> </p>
                                <div class="otp-form justify-content-center text-center">
                                    <input type="tel" class="otp form-control p-0" id="enterotp1" pattern="[0-9]+" maxlength="1">
                                    <input type="tel" class="otp form-control p-0" id="enterotp2" pattern="[0-9]+" maxlength="1">
                                    <input type="tel" class="otp form-control p-0" id="enterotp3" pattern="[0-9]+" maxlength="1">
                                    <input type="tel" class="otp form-control p-0" id="enterotp4" pattern="[0-9]+" maxlength="1">
                                    <input type="tel" class="otp form-control p-0" id="enterotp5" pattern="[0-9]+" maxlength="1">
                                    <input type="tel" class="otp form-control p-0" id="enterotp6" pattern="[0-9]+" maxlength="1">
                                </div>
                                <p class="mb-0">รหัส OTP มีอายุอีก <span id="login-counter">05:00</span> นาที</p>
                            </div>
                        </div>
                        <div class="row divShopOtp" style=" display: none;"><div class="col-sm-12 p-0"><hr></div></div>
                        <div class="row divShopOtp" style=" display: none;">
                            <div class="col-md-12 text-right">
                                <button class="btn btn-success" id="otpcheck" onclick="otpCheck();"> ยืนยัน </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
@*<script src="https://code.jquery.com/jquery-3.2.1.slim.min.js" integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN" crossorigin="anonymous"></script>*@
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js" integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js" integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl" crossorigin="anonymous"></script>

<script>
    var userid = '@Request.RequestContext.HttpContext.Session["UserID"]';
    const queryString = decodeURIComponent(window.location.search);
    const params = new URLSearchParams(queryString);
    const page = params.get('page');
    console.log("Page: " + page);
    if (userid != null) {
        console.log("UserID : " + userid);
    }
    //close modal
    $(document).on('hide.bs.modal', '#exampleModalCenter', function () {
        $(".divShopOtp").css("display", "none");
        $('#login-counter').text("05:00");
    });
    $(document).ready(function () {
        $("#show_hide_password a").on('click', function (event) {
            event.preventDefault();
            if ($('#inputoldPassword').attr("type") == "text") {
                $('#inputoldPassword').attr('type', 'password');
                $('#show_hide_password i').addClass("fa-eye-slash");
                $('#show_hide_password i').removeClass("fa-eye");
            } else if ($('#inputoldPassword').attr("type") == "password") {
                $('#inputoldPassword').attr('type', 'text');
                $('#show_hide_password i').removeClass("fa-eye-slash");
                $('#show_hide_password i').addClass("fa-eye");
            }
        });
        $("#show_hide_newpassword a").on('click', function (event) {
            event.preventDefault();
            if ($('#inputnewPassword').attr("type") == "text") {
                $('#inputnewPassword').attr('type', 'password');
                $('#show_hide_newpassword i').addClass("fa-eye-slash");
                $('#show_hide_newpassword i').removeClass("fa-eye");
            } else if ($('#inputnewPassword').attr("type") == "password") {
                $('#inputnewPassword').attr('type', 'text');
                $('#show_hide_newpassword i').removeClass("fa-eye-slash");
                $('#show_hide_newpassword i').addClass("fa-eye");
            }
        });
        $("#show_hide_confirmpassword a").on('click', function (event) {
            event.preventDefault();
            if ($('#inputConfirmPassword').attr("type") == "text") {
                $('#inputConfirmPassword').attr('type', 'password');
                $('#show_hide_confirmpassword i').addClass("fa-eye-slash");
                $('#show_hide_confirmpassword i').removeClass("fa-eye");
            } else if ($('#inputConfirmPassword').attr("type") == "password") {
                $('#inputConfirmPassword').attr('type', 'text');
                $('#show_hide_confirmpassword i').removeClass("fa-eye-slash");
                $('#show_hide_confirmpassword i').addClass("fa-eye");
            }
        });

        $('#link-forget-modal a').on('click', function (event) {
            event.preventDefault();
            var username = $('#inputusername').val();
        });
    });

    $(document).ready(function () {
        $('#inputConfirmPassword').blur(function () {
            var newpassword = $(this).val();
            var confpass = $('#inputnewPassword').val();
            if (newpassword != confpass) {
                $('#passequal').removeAttr('hidden');
            }
            else {
                $('#passequal').attr('hidden', true);
            }
        });
    });
    function changePassword() {
        var oldpassword = $('#inputoldPassword').val()
        var newpassword = $('#inputnewPassword').val();
        var confpassword = $('#inputConfirmPassword').val();
        if (newpassword.length < 8) {
            Swal.fire({
                title: "รหัสผ่านต้องมีตัวอักษรอย่างน้อย 8 ตัวอักษร",
                icon: "warning"
            });
            return false;
        }
        $.ajax({
            url: '@Url.Action("ChangeNewPasswordPortal", "Account")',
            data: {
                USER: userid,
                password: oldpassword,
                newpassword: newpassword,
                confirmpassword: confpassword,
            },
            type: 'POST',
            dataType: 'JSON',
            success: function (res) {
                if (res == 'Y') {
                    Swal.fire({
                        title: "เปลี่ยนรหัสผ่านสำเร็จ !",
                        icon: "success",
                        confirmButtonText: "OK",
                    }).then((result) => {
                        if (result.isConfirmed) {
                            if (page == "amount") {
                                window.location.assign("../CustomerDashboard/index");
                            }
                            else if (page == "promotion") {
                                window.location.assign("../CustomerDashboard/Promotion");
                            }
                            else if (page == "PendingDelivery") {
                                window.location.assign("../CustomerDashboard/PendingDeliver");
                            }
                            else if (page == "deliveryTrack") {
                                window.location.assign("../CustomerDashboard/DeliveryTrack");
                            }
                            else if (page == "warranty") {
                                window.location.assign("../CustomerDashboard/Warranty");
                            }
                            else if (page == "credit") {
                                window.location.assign("../CustomerDashboard/Credit");
                            }
                            else {
                                window.location.assign("../CustomerDashboard/CustomerMenu");
                            }
                        }
                    });
                }
                else {
                    Swal.fire({
                        title: res,
                        icon: "warning"
                    });
                }
            }
        });
    }

    function generateRef(length) {
        var result = '';
        var characters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';
        var charactersLength = characters.length;
        for (var i = 0; i < length; i++) {
            result += characters.charAt(Math.floor(Math.random() * charactersLength));
        }
        return result;
    }
</script>