    function generateRandomPassword(length) {
        var chars = "abcdefghijklmnopqrstuvwxyz0123456789";
        var password = "";
        for (var i = 0; i < length; i++) {
            var randomNumber = Math.floor(Math.random() * chars.length);
            password += chars.substring(randomNumber, randomNumber + 1);
        }
        return password;
    }

    function checkUsername() {
        var username = $('#inputusername').val();
        $.ajax({
            url: '@Url.Action("CheckUsername", "Account")',
            data: {
                username: username
            },
            type: 'POST',
            dataType: 'JSON',
            beforeSend: function () {

            },
            success: function (res) {
                if (res.message == 'Y') {
                    $('#wronguser').attr('hidden', true);
                }
                else {
                    console.log('Login Log is ' + res.message);
                    $('#wronguser').removeAttr("hidden");
                }
            }
        })
    }

        function Login() {
            $('#count_p').attr('hidden', true);
            $('#ref_show').attr('hidden', true);
            var username = $('#inputusername').val();
            var pass = $('#inputPassword').val();
            var phonenum = $('#phone').val();
            var cuscod = '';
            $.ajax({
                url: '@Url.Action("LoginCus","Account")',
                data: JSON.stringify({
                    User: username,
                    password: pass,
                    page: page
                }),
                type: "POST",
                cache: false,
                dataType: 'json',
                traditional: true,
                contentType: "application/json; charset=utf-8",
                processData: false,
                beforeSend: function () {

                },
                success: function (result) {
                    if (result.message == "Y") {
                        console.log("Result is " + result.message);
                        if (result.page != null && result.page != '') {
                            if (result.page == "amount") { //หน้ายอดซื้อ
                                //alert("amount");
                                window.location.assign("@domainName" + "/CustomerDashboard/index");
                                //window.location.assign("@domainName" + "/MobileCatalog_Test/CustomerDashboard/index");
                            } else if (page == "promotion") {//หน้าโปรโมชั่น
                                //window.location.assign("@domainName" + "/CustomerDashboard/Promotion");
                                //window.location.assign("@domainName" + "/MobileCatalog_Test/CustomerDashboard/Promotion");
                            }
                            else if (page == "PendingDelivery") {//หน้าค้างส่ง
                                window.location.assign("@domainName" + "/CustomerDashboard/PendingDeliver");
                                //window.location.assign("@domainName" + "/MobileCatalog_Test/CustomerDashboard/PendingDeliver");
                            }
                        }
                    } else if (result.message == "N" || result.message == "R") {
                        typeUser = result.UserType;
                        phonenum = result.tel;
                        console.log("N Result " + result.message);
                        console.log("Phone is " + phonenum);
                        console.log("cuscod is " + result.cuscod);
                        console.log("Line : ");
                        $('#phone').val(phonenum);
                        $('#otpphone').val(phonenum);
                        $('#cuscod').val(result.cuscod);

                        $('.modal-otp').modal('show');
                    }
                    else if (result.message == "B") {
                        Swal.fire({
                            title:' <div class="container-fluid bg-warning ">ประกาศ</div>',
                            html: '<img class="rounded" src="../images/logo/AACTAC185x70.jpg" / style="width:74px;height:28px:"> <br/ ><p class="mt-3">ไม่สามารถใช้งานระบบได้</p>',
                            //icon: "warning",
                        });
                    }
                    else {
                        $('#wronguser').removeAttr('hidden');
                        $('#wrongpass').removeAttr('hidden');
                        console.log("Error" + result.message);
                    }
                },
                error: function (er) {

                },
                complete: function (res) {

                }
            }).fail(function (ex) {
                console.log("fail");
            });
         }

