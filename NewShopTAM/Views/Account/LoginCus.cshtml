        function testPress() {
            var amount = $('#enterotp6');
            var pes = amount.val();
            var otpValues = '';

            if (pes !== "") {
                if (!isNaN(pes)) {
                    $('.otp').each(function () {
                        otpValues += $(this).val();
                    });
                    alert("OTP is " + otpValues);
                }
            }
        }

        $(document).ready(function () {
            var inputs = $('.otp');
            inputs.on('input', function () {
                if (isNaN(parseInt($(this).val()))) {
                    $(this).val('');
                } else {
                    if ($(this).val() !== '' && inputs.index(this) < inputs.length - 1) {
                        inputs.eq(inputs.index(this) + 1).select();
                    }
                }
            });
            inputs.on('click', function () {
                $(this).select();
            });
        });

