                                    <input type="tel" class="form-control otp" id="login-otp-4" pattern="[0-9]+" maxlength="1">
                                    <input type="tel" class="form-control otp" id="login-otp-5" pattern="[0-9]+" maxlength="1">
                                    <input type="tel" class="form-control otp" id="login-otp-6" pattern="[0-9]+" maxlength="1">
                                </div>
                                <p class="mb-0">รหัส OTP มีอายุอีก <span id="login-counter">05:00</span> นาที</p>
