    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.14.7/dist/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>
    <script>
        var phone = "";
        var numb = $('#enterotp6').val();
        console.log("Tel : " + phone);
        //$(document).ready(function () {
        //    reCooldown();
        //});
       // reCooldown();
        $(document).ready(function () {
            var inputs = $('.otp');
            inputs.on('input', function () {
                if (isNaN(parseInt($(this).val()))) {
                    $(this).val('');
                } else {
                    if ($(this).val() !== '' && inputs.index(this) < inputs.length - 1) {
                        inputs.eq(inputs.index(this) + 1).select();
                    }
                }
            });
            inputs.on('click', function () {
                $(this).select();
            });
        });

        function sendOtp() {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("","")',
                data: {

                },
                dataType: "JSON",
                beforeSend: function () {

                },
                success: function (result) {

                },
                error: function (er) {

                },
                complete: function (res) {

                }
            }).fail(function (ex) {

            });
        }

        function delaySendOtp() {
            $('#sendotp').addClass("disable-link");
            var startTime = new Date().getTime();
            var endTime = startTime + (17 * 1000);
            var countdownInterval = setInterval(function () {
                var currentTime = new Date().getTime();
                var timeDifference = endTime - currentTime;
                var seconds = Math.floor(timeDifference / 1000);
                var countdownText = "ส่งรหัสยืนยันใหม่ในอีก "+ seconds + " วินาที";
                $('#countdown').text(countdownText);
                if (timeDifference <= 0) {
                    clearInterval(countdownInterval);
                    $('#countdown').text("");
                }
            }, 1000);
            setTimeout(
                function () {
                    $('#sendotp').removeClass("disable-link");
                }, 17000);
        }
        function reCooldown() {
            var countDownTime = 5 * 60;
            function startCountdown() {
                var minutes, seconds;
                var counter = setInterval(function () {
                    minutes = Math.floor(countDownTime / 60);
                    seconds = countDownTime % 60;

                    $('#login-counter').text(pad(minutes) + ':' + pad(seconds));
                    $('#label-countdown').text('นาที');
                    countDownTime--;

                    if (countDownTime < 0) {
                        clearInterval(counter);
                        $('#login-counter').text('00:00');
                        $('#label-countdown').text('');
                    }
                }, 1000);
            }
            startCountdown();
            function pad(val) {
                return val > 9 ? val : "0" + val;
            }
        }
        function otpCheck() {
            var number = '';
            $('.otp').each(function () {
                number += $(this).val();
            });
            alert("Otp is : " + number);
            console.log("OP : " + number);
        }
    </script>
</body>